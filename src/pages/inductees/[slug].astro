---
import BaseLayout from '../../components/BaseLayout.astro';
import BiographyText from '../../components/BiographyText.astro';
import { trackingAttrs } from '../../config/site';
import { parseBiography, summarize } from '../../lib/biography';
import { inducteePortrait } from '../../lib/media';
import inductees from '../../data/inductees.json';

export function getStaticPaths() {
  return inductees.map((record) => ({ params: { slug: record.canonical_slug }, props: { record } }));
}

const { record } = Astro.props;
const classLabel = record.induction_year || record.induction_era;
// Biography portrait, Open Graph/Twitter image, and Person.image all resolve
// through R2 (media.jrhof.org). Pending records fall back to the placeholder.
const portrait = inducteePortrait(record, 'profile');
const portraitIsMissing = portrait.isPlaceholder;
const portraitUrl = portrait.url;
const hasBiography = record.bio_status === 'available';
const biography = hasBiography ? parseBiography(record, inductees) : undefined;
const location = biography?.location;
const surname = record.sort_name.split(',')[0].trim();
const lead = biography?.lead ? summarize(biography.lead, 150) : undefined;
const description = hasBiography && lead && !record.board_review_required
  ? (lead.includes(surname) ? lead : summarize(`${record.display_name}, Class of ${classLabel}. ${lead}`, 158))
  : hasBiography
    ? `Read the Joe Rossi Umpires Hall of Fame biography of ${record.display_name}, Class of ${classLabel}.`
    : `${record.display_name} is listed in the Joe Rossi Umpires Hall of Fame Class of ${classLabel}. A verified biography has not yet been published.`;

const classmates = inductees
  .filter((other) => other.canonical_slug !== record.canonical_slug
    && (other.induction_year || other.induction_era) === classLabel)
  .sort((a, b) => a.sort_name.localeCompare(b.sort_name));
const classHeading = record.induction_year ? `Also inducted in ${classLabel}` : `Also recognized in the ${classLabel} era`;

const canonicalUrl = new URL(record.proposed_canonical_url, Astro.site);
const personId = `${canonicalUrl.href}#person`;
const personSchema: Record<string, unknown> = {
  '@type': 'Person',
  '@id': personId,
  name: record.display_name,
  url: canonicalUrl.href,
  mainEntityOfPage: { '@id': `${canonicalUrl.href}#webpage` },
  award: `Joe Rossi Umpires Hall of Fame, Class of ${classLabel}`,
};
if (!record.board_review_required && biography?.lead) {
  personSchema.description = summarize(biography.lead, 300);
} else if (!hasBiography) {
  personSchema.description = `${record.display_name} is listed in the Joe Rossi Umpires Hall of Fame Class of ${classLabel}. A verified biography has not yet been published.`;
}
if (!record.board_review_required && record.portrait_status === 'verified_candidate') {
  personSchema.image = portrait.url;
}
---
<BaseLayout
  title={record.display_name}
  description={description}
  canonicalPath={record.proposed_canonical_url}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Inductees', path: '/inductees/' },
    { name: record.display_name, path: record.proposed_canonical_url },
  ]}
  structuredData={[personSchema]}
  mainEntityId={personId}
>
  <div class="page-shell">
    <section class="page-surface inductee-profile" aria-label={`${record.display_name} profile`}>
      <a class="profile-back-link" href="/inductees/"><span aria-hidden="true">←</span> All inductees</a>

      <header class="profile-heading">
        <p class="eyebrow">Hall of Fame Inductee</p>
        <h1>{record.display_name}</h1>
        <p class="profile-meta">
          Class of {classLabel}{location && <><span aria-hidden="true"> · </span>{location}</>}
        </p>
        {biography?.credits && <p class="profile-credits">{biography.credits}</p>}
      </header>

      <figure class="profile-portrait-frame">
        <img
          class="profile-portrait"
          src={portraitUrl}
          alt={portraitIsMissing ? `Portrait not yet available for ${record.display_name}` : `Portrait of ${record.display_name}`}
          width="480"
          height="720"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <article class="biography-card" aria-labelledby="biography-heading">
        <h2 id="biography-heading">Biography</h2>
        {biography ? (
          <div class="biography-copy">
            {biography.blocks.map((block) => block.type === 'heading' ? (
              <h3>{block.text}</h3>
            ) : block.type === 'quote' ? (
              <blockquote><p><BiographyText segments={block.segments} /></p></blockquote>
            ) : block.type === 'list' ? (
              <ul>{block.items.map((item) => <li><BiographyText segments={item} /></li>)}</ul>
            ) : (
              <p><BiographyText segments={block.segments} /></p>
            ))}
          </div>
        ) : (
          <div class="bio-unavailable">
            <h3>Verified biography not yet available</h3>
            <p>The public Hall of Fame archive currently records {record.display_name} in the Class of {classLabel}. JRHOF has not yet published a source-verified biography and will not add unsupported details.</p>
            <p>Explore the <a href="/inductees/">complete inductee archive</a>, or <a href="/contact/">contact the Hall of Fame</a> if you can identify a program, clipping, photograph, or other source that may help document this story.</p>
          </div>
        )}
        {biography && (
          <p class="bio-correction">
            Have a correction, photograph, or story about {record.display_name}? <a href="/contact/" {...trackingAttrs('contact_click', { link_context: 'inductee_biography_correction', destination_url: '/contact/' })}>Contact the Hall of Fame</a>.
          </p>
        )}
      </article>

      {classmates.length > 0 && (
        <nav class="class-roster" aria-labelledby="class-roster-heading">
          <h2 id="class-roster-heading">{classHeading}</h2>
          <ul>
            {classmates.map((other) => (
              <li><a href={other.proposed_canonical_url} {...trackingAttrs('inductee_profile_click', { inductee_name: other.display_name, link_context: 'class_roster', destination_url: other.proposed_canonical_url })}>{other.display_name}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .inductee-profile { max-width: 1040px; margin-inline: auto; }
  .profile-back-link {
    display: inline-flex;
    gap: .45rem;
    align-items: center;
    margin-bottom: clamp(1.2rem, 2.5vw, 1.75rem);
    color: var(--blue);
    font-size: .92rem;
    font-weight: 750;
  }
  .profile-heading { text-align: center; }
  .profile-heading .eyebrow { margin-bottom: .35rem; }
  .profile-heading h1 { font-size: clamp(2.1rem, 4.6vw, 3.25rem); overflow-wrap: anywhere; }
  .profile-meta { margin: .55rem 0 0; color: var(--muted); font-size: 1.05rem; font-weight: 650; }
  .profile-portrait-frame { width: min(100%, 360px); margin: clamp(1.35rem, 3vw, 2rem) auto; }
  .profile-portrait {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    object-position: center top;
    background: #dce5ec;
    border: 4px solid rgb(255 255 255 / 88%);
    border-radius: 8px;
    box-shadow: 0 5px 18px rgb(8 43 76 / 16%);
  }
  .biography-card {
    max-width: 820px;
    margin-inline: auto;
    padding: clamp(1.2rem, 3vw, 2rem);
    background: rgb(255 255 255 / 78%);
    border: 1px solid var(--surface-border);
    border-radius: 8px;
    box-shadow: 0 4px 14px rgb(8 43 76 / 9%);
  }
  .biography-card > h2 { margin: 0 0 1.15rem; padding-bottom: .7rem; border-bottom: 1px solid var(--line); font-size: clamp(1.65rem, 2.8vw, 2rem); }
  .biography-copy { max-width: 70ch; margin-inline: auto; color: var(--ink); font-size: clamp(1rem, 1.1vw, 1.05rem); line-height: 1.75; }
  .biography-copy p { margin: 0 0 1.25rem; }
  .biography-copy p:last-child { margin-bottom: 0; }
  .biography-copy a { color: #075b9c; font-weight: 650; text-decoration-thickness: .08em; text-underline-offset: .16em; }
  .biography-copy > p:first-child { font-size: 1.1em; }
  .biography-copy h3 { margin: 2rem 0 .65rem; color: var(--navy); font: 700 1.3rem/1.3 Georgia, "Times New Roman", serif; }
  .biography-copy ul { margin: 0 0 1.25rem; padding-left: 1.25rem; }
  .biography-copy li { margin-bottom: .4rem; padding-left: .2rem; }
  .biography-copy li::marker { color: #b8862b; }
  .biography-copy blockquote { margin: 1.6rem 0; padding: .2rem 0 .2rem 1.2rem; border-left: 4px solid var(--gold); color: var(--navy); font: italic 1.15rem/1.6 Georgia, "Times New Roman", serif; }
  .biography-copy blockquote p { margin: 0; }
  .profile-credits { margin: .3rem 0 0; color: var(--muted); font-size: .95rem; }
  .bio-correction { max-width: 70ch; margin: 1.75rem auto 0; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .95rem; }
  .bio-correction a { color: #075b9c; font-weight: 650; }
  .class-roster { max-width: 820px; margin: clamp(1.25rem, 3vw, 1.75rem) auto 0; padding: clamp(1rem, 2.5vw, 1.5rem) clamp(1.2rem, 3vw, 2rem); background: rgb(255 255 255 / 60%); border: 1px solid var(--surface-border); border-radius: 8px; }
  .class-roster h2 { margin: 0 0 .6rem; font-size: clamp(1.25rem, 2.2vw, 1.45rem); }
  .class-roster ul { margin: 0; padding: 0; list-style: none; columns: 3 12rem; column-gap: 1.5rem; }
  .class-roster li { break-inside: avoid; }
  .class-roster a { display: block; padding: .6rem 0; color: #075b9c; font-weight: 650; text-underline-offset: .16em; }
  .bio-unavailable h3 { margin: 0 0 .55rem; color: var(--navy); font-family: Georgia, "Times New Roman", serif; }
  .bio-unavailable p { margin-bottom: 0; }

  @media (max-width: 760px) {
    .inductee-profile { padding: 1rem; }
    .profile-back-link { margin-bottom: 1rem; }
    .profile-heading h1 { font-size: clamp(2rem, 9vw, 2.65rem); }
    .profile-portrait-frame { width: min(82%, 300px); margin-block: 1.25rem; }
    .biography-card { padding: 1.1rem 1rem 1.25rem; }
    .biography-copy { line-height: 1.72; }
  }
</style>
