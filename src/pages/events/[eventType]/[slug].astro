---
import BaseLayout from '../../../components/BaseLayout.astro';
import Banquet2027Hero from '../../../components/Banquet2027Hero.astro';
import EventArchiveNav from '../../../components/EventArchiveNav.astro';
import EventGallerySection from '../../../components/EventGallerySection.astro';
import EventPhotoCard from '../../../components/EventPhotoCard.astro';
import EventsClosing from '../../../components/EventsClosing.astro';
import PageHero from '../../../components/PageHero.astro';
import VenueLocation from '../../../components/VenueLocation.astro';
import { trackingAttrs } from '../../../config/site';
import { completedEvents, eventDateParts, eventRegistration, events, eventStatusLabels, eventTypeLabels, eventTypePaths, registrationLinkAttrs, registrationNote, upcomingEvents, type EventRecord } from '../../../data/events';
import { galleryCover, galleryCoverPosition } from '../../../data/galleries/covers';
import { formatUsd } from '../../../data/registrations';
import banquet2026Manifest from '../../../../manifests/r2/banquet-2026.json';
import golf2024Manifest from '../../../../manifests/r2/golf-2024.json';
import golf2025Manifest from '../../../../manifests/r2/golf-2025.json';
import golf2026Manifest from '../../../../manifests/r2/golf-2026.json';
import inductees from '../../../data/inductees.json';
import { inducteePortrait } from '../../../lib/media';
import { galleryImagesFromR2Manifest, type R2GalleryManifest } from '../../../data/galleries/r2';

export function getStaticPaths() {
  return events.map((event) => ({
    params: { eventType: event.eventType, slug: event.slug },
    props: { event },
  }));
}

interface Props { event: EventRecord }
const { event } = Astro.props;
const manifests: Record<string, R2GalleryManifest> = {
  'banquet-2026': banquet2026Manifest,
  'golf-2024': golf2024Manifest,
  'golf-2025': golf2025Manifest,
  'golf-2026': golf2026Manifest,
};
const manifest = event.gallery?.manifest ? manifests[event.gallery.manifest] : undefined;
const galleryImages = manifest ? galleryImagesFromR2Manifest(manifest) : [];
const eventInductees = event.inductees
  .map((name) => inductees.find((record) => record.display_name === name))
  .filter(Boolean);
const eventTypeLabel = eventTypeLabels[event.eventType];
const eventTypePath = eventTypePaths[event.eventType];
const isBanquet2027 = event.id === 'banquet-2027';
const online = eventRegistration(event);
const registrationUrl = event.registration?.url;
const registrationOpen = event.registration?.status === 'open' && Boolean(registrationUrl);
// The price is published only after the board approves it (registrations.ts).
const seatPrice = online?.priceApproved
  ? online.earlyBird
    ? `${formatUsd(online.earlyBird.seatPriceCents)} per seat through ${online.earlyBird.endsDisplay}; ${formatUsd(online.seatPriceCents)} per seat afterward`
    : `${formatUsd(online.seatPriceCents)} per seat`
  : '';
const heroRegistration = online && event.registration?.status === 'open'
  ? { open: true, url: registrationUrl, headline: 'Registration is open', detail: [seatPrice, `Register up to ${online.maxSeatsPerOrder} guests at once`].filter(Boolean).join(' · ') }
  : online && event.registration?.status === 'closed'
    ? { open: false, headline: 'Online registration has closed', detail: 'Contact us about seats.' }
    : { open: false, headline: online ? `Registration opens ${online.opensDisplay}` : 'Registration coming soon', detail: seatPrice };
const eventId = new URL(`${event.canonicalPath}#event`, Astro.site).href;
const eventSchema: Record<string, unknown> = {
  '@type': 'Event',
  '@id': eventId,
  name: event.title,
  description: event.seoDescription,
  url: new URL(event.canonicalPath, Astro.site).href,
  eventStatus: event.status === 'scheduled' || event.status === 'registration-open'
    ? 'https://schema.org/EventScheduled'
    : 'https://schema.org/EventCompleted',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  organizer: { '@id': new URL('/#organization', Astro.site).href },
};
if (event.startDate) eventSchema.startDate = event.startDate;
if (event.endDate) eventSchema.endDate = event.endDate;
if (event.venueName || event.venueAddress) {
  eventSchema.location = {
    '@type': 'Place',
    ...(event.venueName ? { name: event.venueName } : {}),
    ...(event.venueUrl ? { url: event.venueUrl } : {}),
    ...(event.venuePostalAddress
      ? { address: { '@type': 'PostalAddress', ...event.venuePostalAddress } }
      : event.venueAddress ? { address: event.venueAddress } : {}),
  };
}
if (event.heroImage) eventSchema.image = [new URL(event.heroImage, Astro.site).href];
if (online?.priceApproved && registrationOpen && registrationUrl) {
  const regularOffer = {
    '@type': 'Offer',
    price: (online.seatPriceCents / 100).toFixed(2),
    priceCurrency: 'USD',
    url: new URL(registrationUrl, Astro.site).href,
    availability: 'https://schema.org/InStock',
    validFrom: online.earlyBird?.endsAt ?? online.opensAt,
    validThrough: new Date(Date.parse(online.closesAt) - 1).toISOString(),
  };
  eventSchema.offers = online.earlyBird ? [
    { ...regularOffer, name: 'Early bird', price: (online.earlyBird.seatPriceCents / 100).toFixed(2), validFrom: online.opensAt, validThrough: new Date(Date.parse(online.earlyBird.endsAt) - 1).toISOString() },
    { ...regularOffer, name: 'Regular' },
  ] : regularOffer;
}
if (event.sponsors.length) eventSchema.sponsor = event.sponsors.map((sponsor) => ({ '@type': 'Organization', name: sponsor.name, ...(sponsor.url ? { url: sponsor.url } : {}) }));
// Lead photograph for past-event pages: the event's hero image, else its gallery cover.
const cover = galleryCover(event);
const overviewPhoto = event.heroImage
  ? { src: event.heroImage, alt: `${event.title}`, width: 1600, height: 1067 }
  : cover ? { src: cover.src, alt: cover.alt, width: cover.width, height: cover.height, position: galleryCoverPosition(event) } : undefined;
const dateParts = eventDateParts(event);
const relatedEvents = [...upcomingEvents, ...completedEvents, ...events.filter((record) => record.status === 'archived')]
  .filter((record) => record.eventType === event.eventType && record.id !== event.id)
  .slice(0, 3);
const programName = event.eventType === 'golf' ? 'Umpire’s Cup tournaments' : 'induction banquets';
const resourceDocuments = [event.flyer, event.program, ...event.documents].filter((document) => document?.status === 'available');
const galleryHeading = event.eventType === 'golf'
  ? `${event.shortTitle}, frame by frame`
  : 'The 2026 induction banquet in photographs';
---
<BaseLayout
  title={event.seoTitle}
  description={event.seoDescription}
  canonicalPath={event.canonicalPath}
  pageType={galleryImages.length ? 'CollectionPage' : 'WebPage'}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Events', path: '/events/' },
    { name: eventTypeLabel, path: eventTypePath },
    { name: event.shortTitle, path: event.canonicalPath },
  ]}
  structuredData={[eventSchema]}
  mainEntityId={eventId}
  bodyClass={isBanquet2027 ? 'banquet-event-body' : undefined}
>
  <div class:list={['page-shell', { 'banquet-2027-page': isBanquet2027 }]}>
    {isBanquet2027 && event.heroImage && event.venueName && event.venueAddress ? (
      <Banquet2027Hero
        title={event.title}
        subtitle={event.subtitle}
        displayDate={event.displayDate}
        venueName={event.venueName}
        address={event.venueAddress}
        image={event.heroImage}
        registration={heroRegistration}
      />
    ) : (
      <PageHero eyebrow={`${event.year} · ${eventTypeLabel}`} title={event.title} intro={event.subtitle} />
    )}

    <section class="section">
      <article class:list={['page-surface', 'event-detail', { 'event-detail-2027': isBanquet2027 }]}>
        {!isBanquet2027 && <EventArchiveNav />}
        {isBanquet2027 && online && !registrationOpen && (
          <aside class="preview-registration" data-preview-registration hidden>
            <div>
              <strong>Registration preview</strong>
              <p>See how guests will reserve seats, choose a meal for each guest and pay through Zeffy.</p>
            </div>
            <a class="button" href={online.registerPath}>Preview registration</a>
          </aside>
        )}

        {isBanquet2027 ? (
          <>
            <section id="honoree-focus" class="class-2027" aria-labelledby="class-2027-heading">
              <div class="class-2027-intro">
                <p class="kicker">Class of 2027</p>
                <h2 id="class-2027-heading">Meet this year’s honorees</h2>
                <p class="honoree-lede">Kirby Clock, Sean Grogan, and Brent Mulliniks join the Hall of Fame on February 6. The induction banquet brings the Colorado baseball community together to recognize the people whose service, leadership, and contributions have strengthened the game.</p>
              </div>
              <div class="inductee-grid">
                {eventInductees.map((record) => record && (
                  <a class="inductee-card" href={record.proposed_canonical_url} {...trackingAttrs('inductee_profile_click', { inductee_name: record.display_name, destination_url: record.proposed_canonical_url })}>
                    <img src={inducteePortrait(record, 'card').url} alt={`Portrait of ${record.display_name}`} width="280" height="420" loading="eager" decoding="async" />
                    <span><strong>{record.display_name}</strong><small>Class of 2027 · Biography coming soon</small></span>
                  </a>
                ))}
              </div>
              <a class="text-link class-2027-past" href="/inductees/">Meet the Hall of Fame’s past inductees <span aria-hidden="true">→</span></a>
            </section>

            <section class="why-attend" aria-labelledby="why-attend-heading">
              <div class="section-heading">
                <p class="kicker">Why attend</p>
                <h2 id="why-attend-heading">Show up for the people who gave so much to the game.</h2>
                <p>Guests make the induction a shared community moment for the honorees and for the families, friends, umpires, and supporters who helped carry their work forward.</p>
              </div>
              <div class="reason-grid">
                <div><strong>Recognize service</strong><span>Celebrate lasting contributions to baseball in Colorado.</span></div>
                <div><strong>Honor the families</strong><span>Share the moment with the people who supported each inductee.</span></div>
                <div><strong>Preserve the legacy</strong><span>Connect this class with the history already entrusted to the Hall of Fame.</span></div>
              </div>
            </section>

            <section id="event-details" class="event-guide" aria-labelledby="event-guide-heading">
              <div class="event-guide-heading">
                <p class="kicker">Plan your visit</p>
                <h2 id="event-guide-heading">Banquet details</h2>
              </div>
              <div class="event-guide-body">
                <div class="event-guide-info">
                  <dl class="event-facts event-facts-2027" aria-label="2027 banquet details">
                    <div><dt>Date</dt><dd>{event.displayDate}</dd></div>
                    {event.venueName && <div><dt>Venue</dt><dd>{event.venueName}{event.venueAddress && <span class="fact-detail">{event.venueAddress}</span>}{event.venueNote && <span class="fact-detail">{event.venueNote}</span>}</dd></div>}
                    <div><dt>Attire</dt><dd>Business casual</dd></div>
                    {online && <div><dt>Tickets</dt><dd>{seatPrice || 'To be announced'}</dd></div>}
                    {online && <div><dt>Meal choices</dt><dd>{online.meals.map((meal) => meal.name).join(' or ')}</dd></div>}
                    <div><dt>Seating</dt><dd>Open seating</dd></div>
                  </dl>
                  <div class="registration-state">
                    <p><strong>{registrationNote(event) ?? 'Registration coming soon'}</strong></p>
                    {online && <p>One registration covers up to {online.maxSeatsPerOrder} guests ({online.maxSeatsPerOrder / 8} tables of 8). Only each guest’s name and meal are needed, and you pay securely through Zeffy, our nonprofit ticketing partner.</p>}
                    {registrationOpen && registrationUrl && <a class="button" href={registrationUrl} {...trackingAttrs('event_register_click', { event_name: event.title, link_context: 'banquet_2027_details', destination_url: registrationUrl })}>Register now</a>}
                  </div>
                  <p class="seating-note">Seating is open except for reserved seating for inductees and their invited guests. We will make reasonable efforts to accommodate group seating requests, but specific tables cannot be guaranteed.</p>
                </div>
                {event.venueName && event.venueAddress && <VenueLocation variant="compact" venueName={event.venueName} address={event.venueAddress} venueWebsiteUrl={event.venueUrl} />}
              </div>
            </section>

            <section class="banquet-footer" aria-labelledby="questions-heading">
              <h2 id="questions-heading">Questions about the banquet?</h2>
              <p>Contact us about attending, group seating, or dietary needs.</p>
              <a class="button" href="/contact/" {...trackingAttrs('contact_click', { link_context: 'banquet_2027_questions', destination_url: '/contact/' })}>Contact the Hall of Fame</a>
              <nav class="banquet-links" aria-label="Banquet and Hall of Fame links">
                <a href="/events/induction-banquet/2026-hall-of-fame-induction-banquet/">2026 banquet gallery</a>
                <a href="/inductees/">Inductee archive</a>
                <a href="/about/">About JRHOF</a>
              </nav>
            </section>
          </>
        ) : (
          <section class:list={['event-overview', { 'has-photo': overviewPhoto }]} aria-labelledby="event-overview-heading">
            {overviewPhoto && (
              <figure class="overview-photo">
                <img src={overviewPhoto.src} alt={overviewPhoto.alt} width={overviewPhoto.width} height={overviewPhoto.height} decoding="async" fetchpriority="high" style={'position' in overviewPhoto && overviewPhoto.position ? `object-position: ${overviewPhoto.position}` : undefined} />
                {dateParts && <div class="date-lockup" aria-hidden="true"><span>{dateParts.month}</span><strong>{dateParts.day}</strong><small>{dateParts.year}</small></div>}
              </figure>
            )}
            <div class="event-story">
              <p class="event-state">{eventStatusLabels[event.status]}</p>
              <h2 id="event-overview-heading">{event.shortTitle}</h2>
              <p>{event.description}</p>
              {event.recap && <p>{event.recap}</p>}
              {registrationNote(event) && <p class="registration-note"><strong>{registrationNote(event)}</strong></p>}
              <dl class="event-facts" aria-label={`${event.year} event details`}>
                <div><dt>Date</dt><dd>{event.displayDate}</dd></div>
                {event.venueName && <div><dt>Venue</dt><dd>{event.venueName}{event.venueAddress && <span class="fact-detail">{event.venueAddress}</span>}</dd></div>}
                {event.gallery?.status === 'published' && <div><dt>Gallery</dt><dd>{galleryImages.length} photographs</dd></div>}
                {event.photographer && <div><dt>Photography</dt><dd>{event.photographer.person ? `${event.photographer.person}, ` : ''}{event.photographer.url ? <a href={event.photographer.url} target="_blank" rel="noopener noreferrer">{event.photographer.name}</a> : event.photographer.name}</dd></div>}
              </dl>
              <div class="button-row">
                {event.registration?.status === 'open' && event.registration.url && <a class="button" href={event.registration.url} {...registrationLinkAttrs(event.registration.url)} {...trackingAttrs('event_register_click', { event_name: event.title, destination_url: event.registration.url })}>Register</a>}
                {galleryImages.length > 0 && <a class="button" href="#gallery">View the photographs</a>}
                <a class="button button-secondary" href={eventTypePath}>Explore the {event.eventType === 'golf' ? 'golf' : 'banquet'} program</a>
              </div>
            </div>
          </section>
        )}

        {!isBanquet2027 && eventInductees.length > 0 && (
          <section aria-labelledby="inductees-heading">
            <header class="events-heading">
              <p class="kicker">Class of {event.year}</p>
              <h2 id="inductees-heading">Honoring the Class of {event.year}</h2>
            </header>
            <div class="inductee-grid">
              {eventInductees.map((record) => record && (
                <a class="inductee-card" href={record.proposed_canonical_url} {...trackingAttrs('inductee_profile_click', { inductee_name: record.display_name, destination_url: record.proposed_canonical_url })}>
                  <img src={inducteePortrait(record, 'card').url} alt={`Portrait of ${record.display_name}`} width="280" height="420" loading="lazy" decoding="async" />
                  <span><strong>{record.display_name}</strong><small>Read biography →</small></span>
                </a>
              ))}
            </div>
          </section>
        )}

        {galleryImages.length > 0 && (
          <div id="gallery" class="gallery-anchor">
          <EventGallerySection
            images={galleryImages}
            year={event.year}
            title={event.shortTitle}
            heading={galleryHeading}
            description={`Browse the complete ${event.year} collection. Open any photograph for the full viewer with keyboard and touch controls.`}
            totalCount={galleryImages.length}
            archiveLabel={event.eventType === 'golf' ? 'The Umpire’s Cup archive' : 'Induction banquet archive'}
            galleryLabel={`${event.year} ${event.shortTitle} photo gallery`}
          />
          </div>
        )}

        {!isBanquet2027 && !galleryImages.length && event.gallery?.status !== 'published' && (
          <section class="archive-note" aria-labelledby="archive-note-heading">
            <p class="kicker">Historical record</p>
            <h2 id="archive-note-heading">Archive materials</h2>
            <p>Verified photographs and documents will be added to this permanent event page as they are digitized and approved.</p>
          </section>
        )}

        {resourceDocuments.length > 0 && (
          <section class="resource-panel" aria-labelledby="resources-heading">
            <h2 id="resources-heading">Event Documents</h2>
            <div class="button-row">
              {resourceDocuments.map((document) => document?.url && <a class="button button-secondary" href={document.url} target="_blank" rel="noopener noreferrer">{document.label}</a>)}
            </div>
          </section>
        )}

        {!isBanquet2027 && relatedEvents.length > 0 && (
          <section aria-labelledby="related-heading">
            <header class="events-heading">
              <p class="kicker">Keep exploring</p>
              <h2 id="related-heading">More {programName}</h2>
            </header>
            <div class="related-grid">{relatedEvents.map((record) => <EventPhotoCard event={record} />)}</div>
          </section>
        )}

        {!isBanquet2027 && <EventsClosing context={event.id} />}
      </article>
    </section>
  </div>
</BaseLayout>

<script>
  // The registration preview link appears only on preview hosts, never on jrhof.org.
  const preview = document.querySelector<HTMLElement>('[data-preview-registration]');
  if (preview && !['jrhof.org', 'www.jrhof.org'].includes(location.hostname)) preview.hidden = false;
</script>

<style>
  .preview-registration { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 1.5rem; padding: 1.15rem 1.4rem; margin-bottom: 1rem; border: 1px solid rgb(232 182 70 / 55%); border-left: 5px solid var(--gold); border-radius: 10px; background: #fff7df; }
  .preview-registration strong { color: var(--navy); font: 700 1.15rem/1.2 Georgia, serif; }
  .preview-registration p { margin: .25rem 0 0; color: #344252; }
  .preview-registration[hidden] { display: none; }
  .class-2027 { display: grid; gap: 1.5rem; justify-items: center; padding: clamp(2rem, 4.5vw, 3.25rem) clamp(1rem, 5vw, 4rem) clamp(2.25rem, 5vw, 3.5rem); text-align: center; }
  .class-2027-intro { max-width: 760px; }
  .class-2027-intro h2 { margin: .3rem 0 .7rem; font-size: clamp(2rem, 3.6vw, 2.75rem); letter-spacing: -.02em; }
  .class-2027 .inductee-grid { width: 100%; max-width: 940px; margin-inline: auto; text-align: left; }
  .event-detail { display: grid; gap: clamp(1.5rem, 3vw, 2.4rem); max-width: 1180px; margin-inline: auto; }
  .banquet-2027-page { width: min(1180px, calc(100% - 2rem)); }
  .event-detail-2027 {
    gap: 0;
    overflow: hidden;
    padding: 0;
    border: 1px solid rgb(8 43 76 / 18%);
    border-radius: 18px;
    background: rgb(255 253 248 / 93%);
    box-shadow: 0 22px 56px rgb(3 18 32 / 22%);
    backdrop-filter: blur(7px);
  }
  .event-detail:not(.event-detail-2027) { max-width: 1120px; gap: clamp(2.25rem, 5vw, 3.5rem); }
  .event-detail > :global(.archive-nav) { margin-bottom: 0; }
  .event-overview { display: grid; overflow: hidden; border: 1px solid var(--surface-border); border-radius: 18px; background: rgb(255 255 255 / 86%); box-shadow: 0 18px 44px rgb(8 43 76 / 12%); }
  .event-overview.has-photo { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); }
  .overview-photo { position: relative; min-height: 340px; margin: 0; background: linear-gradient(160deg, #0a2946, #126293); }
  /* Absolutely placed so a tall (portrait) photo never sets the card's height. */
  .overview-photo img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
  .overview-photo .date-lockup { position: absolute; bottom: 1rem; left: 1rem; display: grid; min-width: 96px; padding: .6rem .8rem; color: white; border: 1px solid rgb(255 255 255 / 30%); border-radius: 12px; background: rgb(2 15 28 / 70%); backdrop-filter: blur(4px); text-align: center; }
  .date-lockup span, .date-lockup small { color: #f3ce87; font-size: .78rem; font-weight: 850; letter-spacing: .14em; }
  .date-lockup strong { font: 800 2.6rem/.95 Georgia, serif; }
  .event-story { padding: clamp(1.4rem, 3.5vw, 2.4rem); }
  .event-story h2 { margin: .3rem 0 .8rem; font-size: clamp(1.8rem, 3.6vw, 2.5rem); letter-spacing: -.02em; }
  .event-story .button-row { margin-top: 1.25rem; }
  .event-overview .event-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem 1.5rem; margin-top: 1.1rem; padding: 0; border: 0; background: transparent; }
  .event-overview .event-facts div { padding-top: .55rem; border-top: 1px solid var(--line); }
  .event-overview .event-facts dt { color: #7c5817; }
  .related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .gallery-anchor { scroll-margin-top: 1rem; }
  .event-state { margin: 0; color: #8a4a18; font-size: .78rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
  .registration-note { padding-left: .8rem; border-left: 4px solid var(--gold); }
  .inductee-status { color: var(--navy); font: 700 1.12rem/1.45 Georgia, serif; }
  .event-facts { display: grid; gap: .78rem; margin: 0; padding: 1.1rem; border: 1px solid rgb(186 131 47 / 26%); border-radius: 12px; background: var(--gold-soft); }
  .event-facts div { display: grid; gap: .08rem; }
  .event-facts dt { color: var(--navy); font-size: .74rem; font-weight: 850; letter-spacing: .06em; text-transform: uppercase; }
  .event-facts dd { margin: 0; }
  .inductee-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .inductee-card { overflow: hidden; color: var(--ink); background: rgb(255 255 255 / 72%); border: 1px solid var(--archive-panel-border); border-radius: 8px; text-decoration: none; }
  .inductee-card img { display: block; width: 100%; aspect-ratio: 2 / 3; object-fit: cover; object-position: center top; }
  .inductee-card span { display: block; padding: .75rem .85rem; }
  .inductee-card strong, .inductee-card small { display: block; }
  .inductee-card strong { color: var(--navy); font: 700 1.08rem/1.2 Georgia, serif; }
  .inductee-card small { margin-top: .25rem; color: var(--blue); }
  .archive-note, .resource-panel { padding: clamp(1rem, 2.5vw, 1.35rem); border: 1px solid var(--surface-border); border-left: 5px solid var(--gold); border-radius: 12px; background: rgb(255 255 255 / 72%); }
  .archive-note h2, .resource-panel h2 { margin: .25rem 0 .55rem; }
  .archive-note p:last-child { margin-bottom: 0; }
  .honoree-lede { margin: 0; color: #344252; font-size: clamp(1.02rem, 1.6vw, 1.15rem); }
  .text-link { color: var(--navy); font-weight: 850; text-decoration-thickness: 2px; text-underline-offset: 4px; }

  .why-attend {
    padding: clamp(2.5rem, 5vw, 3.75rem) clamp(1rem, 5vw, 4rem);
    color: white;
    background: #082b4c;
  }
  .why-attend .kicker { color: #f3ce87; }
  .section-heading { max-width: 760px; margin-inline: auto; text-align: center; }
  .section-heading .kicker { margin-bottom: 0; }
