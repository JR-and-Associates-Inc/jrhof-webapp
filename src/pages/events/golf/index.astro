---
import BaseLayout from '../../../components/BaseLayout.astro';
import EventArchiveNav from '../../../components/EventArchiveNav.astro';
import EventPhotoCard from '../../../components/EventPhotoCard.astro';
import EventsClosing from '../../../components/EventsClosing.astro';
import FeaturedEvent from '../../../components/FeaturedEvent.astro';
import PageHero from '../../../components/PageHero.astro';
import { galleryPhoto } from '../../../data/galleries/covers';
import { galleryEvents, golfEvents, nextEvent } from '../../../data/events';

const upcoming = nextEvent('golf');
const latestGallery = galleryEvents.find((event) => event.eventType === 'golf');
// Golfers on the course in 2026; the cards use group photos.
const cover = latestGallery && galleryPhoto(latestGallery, 41);
const pastTournaments = golfEvents.filter((event) => event.id !== upcoming?.id);
---
<BaseLayout
  title="Umpire’s Cup Golf Tournament"
  description="Explore the Umpire’s Cup golf tournament program and the complete 2024–2026 photography archives."
  canonicalPath="/events/golf/"
  pageType="CollectionPage"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Events', path: '/events/' }, { name: 'Umpire’s Cup Golf Tournament', path: '/events/golf/' }]}
>
  <div class="page-shell">
    <PageHero eyebrow="The Hall of Fame’s summer fundraiser" title="Umpire’s Cup Golf Tournament" intro="Golfers, sponsors, umpires, and friends gathering in support of Colorado’s baseball umpiring legacy." />
    <section class="section">
      <article class="page-surface events-stack">
        <EventArchiveNav />

        {upcoming && <FeaturedEvent event={upcoming} linkContext="golf_index" kicker="Next tournament" />}

        <section class="program-story" aria-labelledby="program-heading">
          {cover && (
            <figure>
              <img src={cover.src} alt="The Umpire’s Cup golf tournament" width={cover.width} height={cover.height} loading="lazy" decoding="async" />
            </figure>
          )}
          <div>
            <p class="kicker">The program</p>
            <h2 id="program-heading">Community on the course</h2>
            <p>The Umpire’s Cup supports the Hall of Fame’s recognition and preservation work while creating a memorable annual gathering for the broader umpiring community.</p>
            <p>Every tournament keeps its permanent page and complete photo gallery.</p>
          </div>
        </section>

        <section aria-labelledby="archive-heading">
          <header class="events-heading">
            <p class="kicker">Year by year</p>
            <h2 id="archive-heading">Golf tournament archive</h2>
          </header>
          <div class="event-card-grid">{pastTournaments.map((event) => <EventPhotoCard event={event} />)}</div>
        </section>

        <EventsClosing context="golf_index" />
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .program-story { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .program-story figure { overflow: hidden; margin: 0; border-radius: 14px; box-shadow: 0 14px 34px rgb(8 43 76 / 14%); }
  .program-story img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  .program-story .kicker { margin: 0; }
  .program-story h2 { margin: .25rem 0 .8rem; font-size: clamp(1.75rem, 3.2vw, 2.35rem); letter-spacing: -.015em; }
  .program-story p:last-child { margin-bottom: 0; }
  @media (max-width: 760px) { .program-story { grid-template-columns: 1fr; } }
</style>
