---
import BaseLayout from '../../../components/BaseLayout.astro';
import EventArchiveNav from '../../../components/EventArchiveNav.astro';
import EventPhotoCard from '../../../components/EventPhotoCard.astro';
import EventsClosing from '../../../components/EventsClosing.astro';
import PageHero from '../../../components/PageHero.astro';
import { events } from '../../../data/events';

const years = [...new Set(events.map((event) => event.year))].sort((a, b) => b - a);
---
<BaseLayout
  title="Events Archive"
  description="Explore the chronological archive of Joe Rossi Umpires Hall of Fame induction banquets and Umpire’s Cup golf tournaments."
  canonicalPath="/events/archive/"
  pageType="CollectionPage"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Events', path: '/events/' },
    { name: 'Events Archive', path: '/events/archive/' },
  ]}
>
  <div class="page-shell">
    <PageHero title="Events Archive" intro="A growing chronological record of Joe Rossi Umpires Hall of Fame induction banquets and Umpire’s Cup golf tournaments, with each entry reflecting only what has been verified." />
    <section class="section">
      <article class="page-surface events-stack">
        <EventArchiveNav />
        <p class="archive-note">This archive is intentionally partial. Programs, flyers, photographs, and fuller details will be added as materials are digitized and approved.</p>
        <div class="year-list">
          {years.map((year) => (
            <section class="year-group" aria-labelledby={`year-${year}`}>
              <h2 id={`year-${year}`}>{year}</h2>
              <div class="year-cards">
                {events.filter((event) => event.year === year).map((event) => <EventPhotoCard event={event} />)}
              </div>
            </section>
          ))}
        </div>
        <EventsClosing context="events_archive" showArchive={false} />
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .archive-note { max-width: 52rem; margin: 0; padding-left: 1rem; border-left: 4px solid var(--gold); }
  .year-list { display: grid; }
  .year-group { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 1.25rem; padding-block: 1.5rem; border-top: 1px solid var(--line); }
  .year-group:first-child { padding-top: 0; border-top: 0; }
  .year-group h2 { margin: 0; color: var(--navy); font: 700 clamp(2rem, 3.4vw, 2.5rem)/1 Georgia, serif; }
  .year-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  @media (max-width: 860px) {
    .year-group { grid-template-columns: 1fr; gap: .75rem; }
    .year-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) { .year-cards { grid-template-columns: 1fr; } }
</style>
