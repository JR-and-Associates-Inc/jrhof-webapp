---
import BaseLayout from '../../../components/BaseLayout.astro';
import EventArchiveNav from '../../../components/EventArchiveNav.astro';
import EventPhotoCard from '../../../components/EventPhotoCard.astro';
import EventsClosing from '../../../components/EventsClosing.astro';
import FeaturedEvent from '../../../components/FeaturedEvent.astro';
import PageHero from '../../../components/PageHero.astro';
import { galleryPhoto } from '../../../data/galleries/covers';
import { banquetEvents, galleryEvents, nextEvent } from '../../../data/events';

const upcoming = nextEvent('induction-banquet');
const latestGallery = galleryEvents.find((event) => event.eventType === 'induction-banquet');
// The table setting from the 2026 banquet; the cards use a speaker photo.
const cover = latestGallery && galleryPhoto(latestGallery, 1);
const pastBanquets = banquetEvents.filter((event) => event.id !== upcoming?.id);
---
<BaseLayout
  title="Hall of Fame Induction Banquet"
  description={`Explore the Joe Rossi Umpires Hall of Fame annual induction banquet${upcoming ? `, the scheduled ${upcoming.year} celebration,` : ','} and immutable yearly archives.`}
  canonicalPath="/events/induction-banquet/"
  pageType="CollectionPage"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Events', path: '/events/' }, { name: 'Induction Banquet', path: '/events/induction-banquet/' }]}
>
  <div class="page-shell">
    <PageHero eyebrow="An annual Hall of Fame tradition" title="Hall of Fame Induction Banquet" intro="Celebrating exceptional individuals and the community that has shaped baseball umpiring across Colorado." />
    <section class="section">
      <article class="page-surface events-stack">
        <EventArchiveNav />

        {upcoming && <FeaturedEvent event={upcoming} linkContext="banquet_index" kicker="Next banquet" />}

        <section class="program-story" aria-labelledby="tradition-heading">
          {cover && (
            <figure>
              <img src={cover.src} alt="Guests at a Joe Rossi Umpires Hall of Fame induction banquet" width={cover.width} height={cover.height} loading="lazy" decoding="async" />
            </figure>
          )}
          <div>
            <p class="kicker">The tradition</p>
            <h2 id="tradition-heading">An evening built around recognition</h2>
            <p>The annual banquet gives inductees, family members, friends, and the umpiring community a dedicated evening to recognize service, achievement, and lasting contributions to baseball in Colorado.</p>
            <p>Each year has a permanent page that grows as programs, galleries, and verified records become available.</p>
          </div>
        </section>

        <section aria-labelledby="archive-heading">
          <header class="events-heading">
            <p class="kicker">Year by year</p>
            <h2 id="archive-heading">Induction banquet archive</h2>
          </header>
          <div class="event-card-grid">{pastBanquets.map((event) => <EventPhotoCard event={event} />)}</div>
        </section>

        <EventsClosing context="banquet_index" />
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .program-story { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .program-story figure { overflow: hidden; margin: 0; border-radius: 14px; box-shadow: 0 14px 34px rgb(8 43 76 / 14%); }
  .program-story img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  .program-story .kicker { margin: 0; }
  .program-story h2 { margin: .25rem 0 .8rem; font-size: clamp(1.75rem, 3.2vw, 2.35rem); letter-spacing: -.015em; }
  .program-story p:last-child { margin-bottom: 0; }
  @media (max-width: 760px) { .program-story { grid-template-columns: 1fr; } }
</style>
