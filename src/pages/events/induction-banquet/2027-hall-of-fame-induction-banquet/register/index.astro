---
// Zeffy registration page for the 2027 banquet. noindex and excluded from the
// sitemap. Until registration opens (src/data/events.ts) it shows an
// "opens soon" notice instead of the Zeffy form, and nothing links here; the
// preview/go-live branch flips the status so the board can review the form.
import BaseLayout from '../../../../../components/BaseLayout.astro';
import ZeffyEmbed from '../../../../../components/ZeffyEmbed.astro';
import { site, trackingAttrs } from '../../../../../config/site';
import { zeffyForms, zeffyHostedUrl } from '../../../../../config/zeffy';
import { eventTypeLabels, eventTypePaths, getEvent } from '../../../../../data/events';
import inductees from '../../../../../data/inductees.json';
import { findRegistration, formatUsd, mealChoicesText } from '../../../../../data/registrations';
import { inducteePortrait } from '../../../../../lib/media';

const event = getEvent('banquet-2027');
const registration = findRegistration('banquet-2027')!;
const registerPath = registration.registerPath;
const contactHref = `mailto:${site.contactEmail}`;
const hostedCheckout = zeffyHostedUrl(zeffyForms.banquet2027);
const honorees = event.inductees
  .map((name) => inductees.find((record) => record.display_name === name))
  .filter((record): record is (typeof inductees)[number] => Boolean(record));
const earlyBird = registration.earlyBird;
const registrationOpen = event.registration?.status === 'open';
const mealChoices = mealChoicesText(registration.meals);
const seatingPolicy = 'Seating is open except for reserved seating for inductees and their invited guests. We will make reasonable efforts to accommodate group seating requests, but specific tables cannot be guaranteed.';
---
<BaseLayout
  title={`Register: ${event.title}`}
  description={`Reserve seats for the ${event.title} on ${event.displayDate} at ${event.venueName}.`}
  canonicalPath={registerPath}
  noindex={true}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Events', path: '/events/' },
    { name: eventTypeLabels[event.eventType], path: eventTypePaths[event.eventType] },
    { name: event.shortTitle, path: event.canonicalPath },
    { name: 'Register', path: registerPath },
  ]}
>
  <div class="page-shell register-shell">
    {registrationOpen && (
      <p class="preview-ribbon" data-preview-ribbon hidden>
        <strong>Go-live preview.</strong> This is how jrhof.org will look when registration opens. Payments in this form are real, so please do not complete one.
      </p>
    )}

    <header class="register-hero">
      {event.heroImage && <img src={event.heroImage} alt="" width="1774" height="887" fetchpriority="high" decoding="async" />}
      <div class="register-hero-shade" aria-hidden="true"></div>
      <div class="register-hero-content">
        <p class="register-overline">Registration</p>
        <h1>{registrationOpen ? 'Reserve your seats' : 'Registration opens soon'}</h1>
        <p class="register-intro">{event.title} · Celebrating the Class of 2027</p>
        <dl class="register-facts" aria-label="Banquet details">
          <div><dt>Date</dt><dd>{event.displayDate}</dd></div>
          <div><dt>Venue</dt><dd>{event.venueName}{event.venueNote && <small class="venue-note">{event.venueNote}</small>}</dd></div>
          <div><dt>Attire</dt><dd>Business casual</dd></div>
        </dl>
      </div>
    </header>

    {registrationOpen && (
      <ol class="register-steps" aria-label="How registration works">
        <li><span aria-hidden="true">1</span><div><strong>Choose your seats</strong><small>Up to {registration.maxSeatsPerOrder} guests per order</small></div></li>
        <li><span aria-hidden="true">2</span><div><strong>Tell us about each guest</strong><small>First and last name and a meal; the rest is optional</small></div></li>
        <li><span aria-hidden="true">3</span><div><strong>Pay securely</strong><small>Receipt and e-tickets by email</small></div></li>
      </ol>
    )}

    <div class="register-layout">
      {registrationOpen ? (
        <section class="form-panel" aria-labelledby="form-heading">
          <p class="kicker">Banquet registration</p>
          <h2 id="form-heading">Select your seats</h2>
          <p class="form-lede">Add a seat for everyone in your party, including yourself, then complete each guest’s name, meal and dietary needs. You can add a gift to the Hall of Fame at the same time.</p>

          <ZeffyEmbed
            form={zeffyForms.banquet2027}
            conversion="registration_complete"
            analytics={{ event_slug: '2027-hall-of-fame-induction-banquet', event_year: '2027' }}
          />

          <div class="payment-note">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 2a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V7a5 5 0 0 0-5-5Zm-3 5a3 3 0 1 1 6 0v3H9V7Zm3 7a2 2 0 0 1 1 3.73V19h-2v-1.27A2 2 0 0 1 12 14Z"/></svg>
            <p><strong>Secure checkout by Zeffy.</strong> Pay by credit card, debit card or bank transfer. On a phone and prefer Apple Pay or Google Pay? <a href={hostedCheckout} target="_blank" rel="noopener noreferrer" {...trackingAttrs('external_partner_click', { partner: 'Zeffy', link_context: 'banquet_2027_register', destination_url: hostedCheckout })}>Open the full-page checkout</a>.</p>
          </div>
          <p class="fine-print">Zeffy, our nonprofit ticketing partner, charges the Hall of Fame no platform or processing fees. At checkout it asks for an optional contribution to Zeffy, which you can change to $0. Your receipt and e-tickets arrive by email from Zeffy. See our <a href="/privacy-policy/">Privacy Policy</a> and <a href="/terms/">Terms of Use</a>.</p>
        </section>
      ) : (
        <section class="form-panel" aria-labelledby="form-heading">
          <p class="kicker">Banquet registration</p>
          <h2 id="form-heading">Online registration opens soon</h2>
          <p class="form-lede">Seats for the {event.title} will be available here soon{earlyBird ? <>: {formatUsd(earlyBird.seatPriceCents)} per guest through {earlyBird.endsDisplay}, then {formatUsd(registration.seatPriceCents)}</> : null}. One order can cover up to {registration.maxSeatsPerOrder} guests ({registration.maxSeatsPerOrder / 8} tables of 8).</p>
          <p>For a larger group, accessibility or dietary questions, email <a href={contactHref}>{site.contactEmail}</a>.</p>
          <a class="text-link" href={event.canonicalPath}>Back to event details <span aria-hidden="true">→</span></a>
        </section>
      )}

      <aside class="register-summary" aria-label="Banquet summary">
        {honorees.length > 0 && (
          <section class="summary-card">
            <p class="kicker">Class of 2027</p>
            <ul class="honoree-list">
              {honorees.map((record) => (
                <li>
                  <a href={record.proposed_canonical_url}>
                    <img src={inducteePortrait(record, 'card').url} alt={`Portrait of ${record.display_name}`} width="120" height="180" loading="lazy" decoding="async" />
                    <span>{record.display_name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="summary-card">
          <h3>Tickets</h3>
          <dl class="price-list">
            {earlyBird && (
              <div>
                <dt>Early bird<small>Through {earlyBird.endsDisplay}</small></dt>
                <dd>{formatUsd(earlyBird.seatPriceCents)}</dd>
              </div>
            )}
            <div>
              <dt>{earlyBird ? 'Regular' : 'Banquet seat'}<small>{earlyBird ? 'From December 14 until' : 'Until'} registration closes {registration.closesDisplay}</small></dt>
              <dd>{formatUsd(registration.seatPriceCents)}</dd>
            </div>
          </dl>
          <p>Per guest, including a meal: {mealChoices}. Up to {registration.maxSeatsPerOrder} guests per order ({registration.maxSeatsPerOrder / 8} tables of 8).</p>
        </section>

        <section class="summary-card">
          <h3>Seating</h3>
          <p>{seatingPolicy}</p>
        </section>

        <section class="summary-card">
          <h3>Refunds</h3>
          <p>{registration.refundPolicy}</p>
        </section>

        <section class="summary-card summary-help">
          <h3>Questions?</h3>
          <p>For a larger group, accessibility or dietary questions, email <a href={contactHref}>{site.contactEmail}</a>.</p>
          <a class="text-link" href={event.canonicalPath}>Back to event details <span aria-hidden="true">→</span></a>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  // The preview notice appears only on preview hosts, never on jrhof.org.
  const ribbon = document.querySelector<HTMLElement>('[data-preview-ribbon]');
  if (ribbon && !['jrhof.org', 'www.jrhof.org'].includes(location.hostname)) ribbon.hidden = false;
</script>

<style>
  .register-shell { display: grid; gap: clamp(1rem, 2.4vw, 1.5rem); width: min(1180px, calc(100% - 2rem)); }

  .preview-ribbon { margin: 0; padding: .7rem 1rem; border: 1px solid rgb(232 182 70 / 60%); border-left: 5px solid var(--gold); border-radius: 10px; color: #4b3610; background: #fff7df; }
  .preview-ribbon[hidden] { display: none; }

  .register-hero { position: relative; isolation: isolate; overflow: hidden; min-height: clamp(300px, 34vw, 380px); border-radius: 20px; color: white; background: #05182a; box-shadow: 0 26px 64px rgb(3 18 32 / 24%); }
  .register-hero > img, .register-hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .register-hero > img { z-index: -2; object-fit: cover; object-position: 58% center; }
  .register-hero-shade { z-index: -1; background: linear-gradient(90deg, rgb(2 15 28 / 97%) 0%, rgb(2 15 28 / 88%) 42%, rgb(2 15 28 / 30%) 78%, rgb(2 15 28 / 10%) 100%), linear-gradient(0deg, rgb(2 15 28 / 50%), transparent 50%); }
  .register-hero-content { display: flex; flex-direction: column; justify-content: center; width: min(680px, 66%); min-height: inherit; padding: clamp(1.75rem, 4.5vw, 3.5rem); }
  .register-overline { width: fit-content; margin: 0 0 .9rem; padding-bottom: .35rem; border-bottom: 2px solid var(--gold); color: #f3ce87; font-size: .76rem; font-weight: 850; letter-spacing: .16em; text-transform: uppercase; }
  .register-hero h1 { margin: 0; color: white; font-size: clamp(2.6rem, 5.4vw, 4.4rem); line-height: 1; letter-spacing: -.035em; text-shadow: 0 3px 22px rgb(0 0 0 / 32%); }
  .register-intro { margin: .85rem 0 0; color: #f7e8bd; font: 400 clamp(1.05rem, 1.7vw, 1.28rem)/1.45 Georgia, "Times New Roman", serif; }
  .register-facts { display: flex; flex-wrap: wrap; gap: 1rem 2.25rem; margin: 1.5rem 0 0; padding-top: .95rem; border-top: 1px solid rgb(255 255 255 / 27%); }
  .register-facts dt { color: #f3ce87; font-size: .7rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
  .register-facts dd { margin: .12rem 0 0; color: white; font-weight: 760; line-height: 1.35; }

  .register-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; margin: 0; padding: 0; list-style: none; }
  .register-steps li { display: flex; align-items: center; gap: .8rem; padding: .9rem 1rem; border: 1px solid var(--surface-border); border-radius: 12px; background: var(--surface-bg); box-shadow: var(--surface-shadow); }
  .register-steps span { display: inline-grid; flex: 0 0 auto; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 50%; color: var(--navy); background: var(--gold); font: 800 1rem/1 system-ui, sans-serif; }
  .register-steps strong { display: block; color: var(--navy); font: 700 1.02rem/1.25 Georgia, serif; }
  .register-steps small { display: block; margin-top: .15rem; color: var(--muted); }

  .register-layout { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(280px, 1fr); gap: clamp(1rem, 2.4vw, 1.5rem); align-items: start; }
  .form-panel, .summary-card { border: 1px solid var(--surface-border); border-radius: 14px; background: var(--surface-bg); box-shadow: var(--surface-shadow); }
  .form-panel { display: grid; gap: 1rem; padding: clamp(1.15rem, 3vw, 2rem); }
  .kicker { margin: 0; color: #7c5817; font-size: .74rem; font-weight: 850; letter-spacing: .14em; text-transform: uppercase; }
  .form-panel h2 { margin: -.4rem 0 0; font-size: clamp(1.8rem, 3.2vw, 2.4rem); }
  .form-lede { margin: 0; color: #344252; }
  .payment-note { display: flex; align-items: flex-start; gap: .75rem; padding: .9rem 1rem; border-radius: 10px; color: var(--navy); background: #eef3f7; }
  .payment-note svg { flex: 0 0 auto; margin-top: .1rem; }
  .payment-note p { margin: 0; color: #22303d; }
  .payment-note a { color: var(--navy); font-weight: 750; }
  .fine-print { margin: 0; color: var(--muted); font-size: .9rem; }

  .register-summary { display: grid; gap: 1rem; position: sticky; top: 1rem; }
  .summary-card { padding: 1.1rem 1.2rem; }
  .summary-card h3 { margin: 0 0 .55rem; color: var(--navy); font-size: 1.2rem; }
  .summary-card p { margin: 0; color: #344252; font-size: .95rem; }
  .honoree-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem; margin: .7rem 0 0; padding: 0; list-style: none; }
  .honoree-list a { display: grid; gap: .35rem; color: var(--navy); text-decoration: none; }
  .honoree-list img { display: block; width: 100%; aspect-ratio: 2 / 3; border-radius: 8px; object-fit: cover; object-position: center top; background: #dde5ec; }
  .honoree-list span { font: 700 .9rem/1.2 Georgia, serif; text-align: center; }
  .honoree-list a:hover span { text-decoration: underline; }
  .price-list { display: grid; gap: .55rem; margin: 0 0 .7rem; }
  .price-list div { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-bottom: .55rem; border-bottom: 1px solid var(--line); }
  .price-list dt { color: var(--ink); font-weight: 750; }
  .price-list dt small { display: block; color: var(--muted); font-weight: 500; font-size: .82rem; }
  .price-list dd { margin: 0; color: var(--navy); font: 700 1.5rem/1 Georgia, serif; }
  .summary-help { background: #fff7df; border-color: rgb(232 182 70 / 45%); }
  .summary-help p { margin-bottom: .7rem; }
  .text-link { color: var(--navy); font-weight: 850; text-decoration-thickness: 2px; text-underline-offset: 4px; }

  @media (max-width: 900px) {
    .register-layout { grid-template-columns: 1fr; }
    .register-summary { position: static; }
  }

  @media (max-width: 700px) {
    .register-hero { min-height: 340px; }
    .register-hero-shade { background: linear-gradient(0deg, rgb(2 15 28 / 98%) 0%, rgb(2 15 28 / 88%) 60%, rgb(2 15 28 / 40%) 100%); }
    .register-hero-content { justify-content: flex-end; width: 100%; padding: 1.5rem 1.15rem 1.6rem; }
    .register-facts { display: grid; grid-template-columns: 1fr; gap: .6rem; }
    .register-steps { grid-template-columns: 1fr; }
  }
  .venue-note { display: block; margin-top: .2rem; color: #f7e8bd; font-size: .85rem; font-weight: 500; }
</style>
