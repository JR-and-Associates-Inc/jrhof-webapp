---
// Zeffy registration preview for the 2027 banquet. Same path as the Stripe
// preview on feature/banquet-stripe-registration so both can be compared side
// by side. noindex, excluded from the sitemap, and not linked from the event
// page while registration is not open.
import BaseLayout from '../../../../../components/BaseLayout.astro';
import PageHero from '../../../../../components/PageHero.astro';
import ZeffyEmbed from '../../../../../components/ZeffyEmbed.astro';
import { site } from '../../../../../config/site';
import { zeffyForms } from '../../../../../config/zeffy';
import { eventTypeLabels, eventTypePaths, getEvent } from '../../../../../data/events';

const event = getEvent('banquet-2027');
const registerPath = `${event.canonicalPath}register/`;
const contactHref = `mailto:${site.contactEmail}`;
---
<BaseLayout
  title={`Register: ${event.title}`}
  description={`Register for the ${event.title} on ${event.displayDate}.`}
  canonicalPath={registerPath}
  noindex={true}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Events', path: '/events/' },
    { name: eventTypeLabels[event.eventType], path: eventTypePaths[event.eventType] },
    { name: event.shortTitle, path: event.canonicalPath },
    { name: 'Register', path: registerPath },
  ]}
>
  <div class="page-shell">
    <PageHero
      eyebrow={`${event.displayDate}${event.venueName ? ` · ${event.venueName}` : ''}`}
      title={`Register for the ${event.shortTitle}`}
      intro="Reserve seats for your party, then pay securely through Zeffy, our nonprofit ticketing partner."
    />
    <section class="section">
      <article class="page-surface registration">
        <p class="reg-preview"><strong>Preview.</strong> This page shows how banquet registration would work with Zeffy. Registration is not open yet, so please do not complete a payment.</p>

        <div class="reg-summary">
          <strong>Banquet registration</strong>
          <p>{event.displayDate}{event.venueName && <> at {event.venueName}</>}{event.venueAddress && <>, {event.venueAddress}</>}.</p>
          <p>Please include every person attending, with a name, meal choice and any dietary needs for each guest.</p>
        </div>

        <ZeffyEmbed form={zeffyForms.banquet2027} />

        <p class="hint">Zeffy charges the Hall of Fame no platform or processing fees. At checkout it asks for an optional contribution to Zeffy, which you can change to $0. Your receipt comes from Zeffy by email.</p>
        <p class="reg-help">Questions or a large group? Email <a href={contactHref}>{site.contactEmail}</a>.</p>
        <div class="button-row">
          <a class="button button-secondary" href={event.canonicalPath}>Back to event details</a>
        </div>
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .registration { display: grid; gap: 1.5rem; max-width: 820px; margin-inline: auto; }
  .registration .button-row { margin-top: 0; }
  .reg-summary { display: grid; gap: .4rem; margin: 0; padding: 1rem; border-radius: 10px; background: var(--gold-soft); }
  .reg-summary p { margin: 0; }
  .reg-preview { margin: 0; padding: .8rem 1rem; border: 2px dashed #c58a00; border-radius: 8px; color: #5b3a00; background: #ffe9a8; }
  .hint { margin: 0; color: var(--muted); font-size: .95rem; }
  .reg-help { margin: 0; }
</style>
