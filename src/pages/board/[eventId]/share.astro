---
import { registrations, type RegistrationConfig } from '../../../data/registrations';
import { CHANNELS } from '../../../lib/registration-attribution';
export function getStaticPaths() {
  return registrations.map((event) => ({ params: { eventId: event.id }, props: { event } }));
}
const { event } = Astro.props as { event: RegistrationConfig };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="description" content={`Create invitation links and QR codes for the ${event.title}.`} />
  <title>Share links &amp; QR codes · JRHOF Board</title>
</head>
<body>
<header><div><p>JRHOF Board</p><h1>Share links &amp; QR codes</h1></div><a href="/board/logout/">Sign out</a></header>
<main data-share-tool data-register-path={event.registerPath} data-event-id={event.id}>
  <a href={`/board/${event.id}/`}>← Back to dashboard</a>
  <p class="test" data-preview hidden>TEST MODE: these links point to this preview and use Stripe test payments. Use them for rehearsal only; do not print or send them to attendees.</p>
  <section>
    <h2>{event.title}</h2>
    <p>Choose where your invitation will appear, name it, then copy the link or download its QR image. Registrations keep these labels so the board can see which outreach they came from.</p>
    <p class="help">Use campaign names such as “november newsletter” or “club flyer.” Do not enter anyone’s name, email, phone number, or other personal information.</p>
    <div class="grid">
      <div>
        <label for="channel">1. Where will people see it?</label>
        <select id="channel">{Object.entries(CHANNELS).map(([key, value]) => <option value={key}>{value.label}</option>)}</select>
        <label for="invitation">2. Name this invitation</label>
        <input id="invitation" value="november-invitation" maxlength="80" autocomplete="off" aria-describedby="name-help" />
        <p class="help" id="name-help">Letters, numbers, and short descriptive words work best.</p>
        <label for="share-url">3. Use the registration link</label>
        <input id="share-url" type="url" readonly />
        <div class="actions"><button type="button" id="copy" disabled>Copy link</button><a id="open" target="_blank" rel="noopener noreferrer" aria-disabled="true">Open and test link ↗</a></div>
        <details><summary>Show campaign labels</summary><dl id="labels"></dl></details>
        <p class="help">Google Ad Grant ads use automatic tagging. Use the plain registration address for ads; this tool is for email, social, partners, and print.</p>
      </div>
      <div class="qr-panel">
        <canvas id="qr" width="720" height="720" aria-label="QR code for this registration invitation"></canvas>
        <a class="button" id="download" aria-disabled="true">Download QR image</a>
        <p class="help">720 × 720 PNG. Open the link and scan the downloaded image before sharing or printing.</p>
      </div>
    </div>
    <p id="status" role="status" aria-live="polite">Preparing the link and QR image…</p>
    <noscript>This tool needs JavaScript to generate links and QR images.</noscript>
  </section>
</main>
</body>
</html>
<script>
  import QRCode from 'qrcode';
  import jsQR from 'jsqr';
  import { campaignLabel, campaignUrl, CHANNELS } from '../../../lib/registration-attribution';
  const tool = document.querySelector<HTMLElement>('[data-share-tool]')!;
  const channel = document.querySelector<HTMLSelectElement>('#channel')!;
  const invitation = document.querySelector<HTMLInputElement>('#invitation')!;
  const output = document.querySelector<HTMLInputElement>('#share-url')!;
  const canvas = document.querySelector<HTMLCanvasElement>('#qr')!;
  const download = document.querySelector<HTMLAnchorElement>('#download')!;
  const open = document.querySelector<HTMLAnchorElement>('#open')!;
  const copy = document.querySelector<HTMLButtonElement>('#copy')!;
  const status = document.querySelector<HTMLElement>('#status')!;
  const labels = document.querySelector<HTMLElement>('#labels')!;
  const isPreview = location.hostname.endsWith('.workers.dev') || ['localhost', '127.0.0.1'].includes(location.hostname);
  document.querySelector<HTMLElement>('[data-preview]')!.hidden = !isPreview;
  let sequence = 0;
  const logo = new Image();
  const logoReady = new Promise<boolean>((resolve) => { logo.onload = () => resolve(true); logo.onerror = () => resolve(false); });
  logo.src = '/images/jrhof-emblem.webp';
  const verify = (target: HTMLCanvasElement, url: string) => {
    const image = target.getContext('2d', { willReadFrequently: true })!.getImageData(0, 0, 720, 720);
    return jsQR(image.data, 720, 720, { inversionAttempts: 'dontInvert' })?.data === url;
  };
  const render = async () => {
    const current = ++sequence;
    canvas.dataset.verified = 'false';
    download.removeAttribute('href'); download.setAttribute('aria-disabled', 'true');
    open.removeAttribute('href'); open.setAttribute('aria-disabled', 'true'); copy.disabled = true;
    canvas.getContext('2d')!.clearRect(0, 0, 720, 720);
    const name = campaignLabel(invitation.value);
    if (name.length < 2 || /[@\u0000-\u001f\u007f]/.test(invitation.value)) {
      output.value = ''; labels.replaceChildren(); status.textContent = 'Enter a short invitation name with at least two letters or numbers, without contact details.'; return;
    }
    const url = campaignUrl(location.origin, tool.dataset.registerPath!, tool.dataset.eventId!, channel.value as keyof typeof CHANNELS, name);
    output.value = url.href; open.href = url.href; open.removeAttribute('aria-disabled'); copy.disabled = false;
    labels.replaceChildren();
    for (const [key, value] of url.searchParams) {
      const dt = document.createElement('dt'); dt.textContent = key.replace('utm_', '');
      const dd = document.createElement('dd'); dd.textContent = value; labels.append(dt, dd);
    }
    status.textContent = 'Preparing and checking the QR image…';
    const target = document.createElement('canvas');
    const options = { width: 720, margin: 4, errorCorrectionLevel: 'H' as const, color: { dark: '#082b4c', light: '#ffffff' } };
    try {
      await QRCode.toCanvas(target, url.href, options);
      let branded = false;
      if (await logoReady) {
        const ctx = target.getContext('2d')!;
        ctx.fillStyle = '#ffffff'; ctx.fillRect(292, 292, 136, 136); ctx.drawImage(logo, 300, 300, 120, 120); branded = true;
      }
      if (!verify(target, url.href)) {
        await QRCode.toCanvas(target, url.href, options); branded = false;
      }
      if (current !== sequence) return;
      if (!verify(target, url.href)) throw new Error('QR did not decode');
      canvas.getContext('2d')!.drawImage(target, 0, 0);
      canvas.dataset.verified = 'true';
      download.href = target.toDataURL('image/png');
      download.download = `jrhof-${tool.dataset.eventId}-${name}${isPreview ? '-TEST' : ''}-qr.png`;
      download.removeAttribute('aria-disabled');
      status.textContent = `${branded ? 'JRHOF QR' : 'QR'} verified and ready. Open the link or scan once before sharing.`;
    } catch {
      if (current === sequence) status.textContent = 'The link is ready, but the QR image could not be verified. Use the link instead.';
    }
  };
  channel.addEventListener('change', () => { void render(); });
  invitation.addEventListener('input', () => { void render(); });
  copy.addEventListener('click', async () => {
    if (!output.value) return;
    try { await navigator.clipboard.writeText(output.value); status.textContent = 'Link copied. Paste it into your invitation.'; }
    catch { output.focus(); output.select(); status.textContent = 'The link is selected. Copy it using your browser.'; }
  });
  void render();
</script>
<style>
  :root { --navy: #082b4c; --gold: #d1aa4e; --muted: #5b6776; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #f5f4f0; color: #1d2733; font: 16px/1.5 system-ui, sans-serif; }
  header { padding: 1rem clamp(1rem, 4vw, 2rem); background: var(--navy); color: white; border-bottom: 4px solid var(--gold); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; align-items: center; }
  header p { margin: 0; color: #f3ce87; font-size: .8rem; font-weight: 800; letter-spacing: .12em; }
  h1 { margin: .2rem 0 0; font: 700 clamp(1.5rem, 4vw, 2rem)/1.2 Georgia, serif; }
  header a { color: white; }
  main { max-width: 1180px; margin: auto; padding: 1.5rem clamp(1rem, 4vw, 2rem) 3rem; }
  section { padding: clamp(1rem, 3vw, 1.5rem); background: white; border: 1px solid #d9dee4; border-radius: 10px; margin-top: 1rem; }
  h2 { color: var(--navy); font: 700 1.35rem Georgia, serif; }
  a { color: var(--navy); font-weight: 700; }
  .test { padding: 1rem; border: 2px dashed #c58a00; border-radius: 8px; background: #ffe9a8; color: #5b3a00; font-weight: 700; }
  [hidden] { display: none !important; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 340px); gap: 2rem; }
  .grid > * { min-width: 0; }
  label { display: block; margin: 1rem 0 .4rem; font-weight: 700; color: var(--navy); }
  input, select { width: 100%; min-width: 0; min-height: 48px; padding: .6rem; font: inherit; border: 1px solid #9aa6b2; border-radius: 6px; }
  input:focus, select:focus, button:focus-visible, a:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
  #share-url { font-size: .85rem; }
  .help { color: var(--muted); font-size: .9rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin: .8rem 0; }
  button, .button { display: inline-block; padding: .65rem 1rem; min-height: 44px; border: 2px solid var(--navy); border-radius: 7px; background: var(--navy); color: white; font: inherit; font-weight: 700; text-decoration: none; cursor: pointer; }
  [aria-disabled='true'] { pointer-events: none; opacity: .5; }
  button:disabled { opacity: .5; cursor: default; }
  .qr-panel { text-align: center; }
  canvas { display: block; width: 100%; height: auto; margin: 1rem auto; border: 1px solid #d9dee4; }
  dd { margin: 0 0 .5rem; overflow-wrap: anywhere; }
  dt { color: var(--muted); font-size: .85rem; text-transform: capitalize; }
  summary { cursor: pointer; font-weight: 700; }
  #status { padding: .8rem; border-left: 4px solid var(--gold); background: #fff7df; }
  @media (max-width: 700px) { .grid { grid-template-columns: 1fr; gap: 1rem; } canvas { max-width: 300px; } }
</style>
