<section class="campaign-builder" aria-labelledby="campaign-link-heading" data-campaign-link-builder>
  <div class="campaign-copy">
    <p class="kicker">Campaign links and QR codes</p>
    <h2 id="campaign-link-heading">Make every invitation measurable</h2>
    <p>Choose where the invitation will appear. The link and QR code carry standard UTM labels into the registration ledger; they do not identify the visitor.</p>
  </div>

  <div class="builder-grid">
    <form class="builder-form" data-campaign-form>
      <div>
        <label for="campaign-source">Source</label>
        <select id="campaign-source" name="source">
          <option value="jrhof_email">JRHOF email</option>
          <option value="board_member">Board member</option>
          <option value="partner">Community partner</option>
          <option value="print">Printed material</option>
          <option value="facebook">Facebook</option>
          <option value="google">Google</option>
        </select>
      </div>
      <div>
        <label for="campaign-medium">Medium</label>
        <select id="campaign-medium" name="medium">
          <option value="email">Email</option>
          <option value="qr">QR code</option>
          <option value="referral">Partner link</option>
          <option value="organic_social">Organic social</option>
          <option value="cpc">Paid search</option>
        </select>
      </div>
      <div>
        <label for="campaign-name">Campaign</label>
        <input id="campaign-name" name="campaign" value="banquet_2027" maxlength="160" pattern="[a-z0-9_-]+" required />
      </div>
      <div>
        <label for="campaign-content">Content label</label>
        <input id="campaign-content" name="content" value="save_the_date" maxlength="160" pattern="[a-z0-9_-]+" aria-describedby="campaign-content-help" />
        <small id="campaign-content-help">Use a short label such as <code>save_the_date</code>, <code>board_letter</code>, or <code>table_card</code>.</small>
      </div>
      <div class="full">
        <label for="campaign-term">Keyword <span>(optional; paid search only)</span></label>
        <input id="campaign-term" name="term" maxlength="160" />
      </div>
    </form>

    <div class="campaign-output">
      <canvas width="220" height="220" data-campaign-qr aria-label="QR code for the generated test registration link"></canvas>
      <div class="link-output">
        <label for="campaign-url">Tagged registration link</label>
        <input id="campaign-url" type="url" readonly data-campaign-url />
        <div class="output-actions">
          <button class="button" type="button" data-copy-campaign>Copy link</button>
          <a class="button button-secondary" href="#" download="jrhof-banquet-2027-qr.png" data-download-qr>Download QR</a>
        </div>
        <p data-campaign-status aria-live="polite">Generating the QR code…</p>
      </div>
    </div>
  </div>
  <p class="builder-note"><strong>Preview note:</strong> links use the hostname currently showing this board report. A short <code>jrhof.org/go/…</code> redirect can be assigned at launch after the final destination and campaign names are approved.</p>
</section>

<script>
  import QRCode from 'qrcode';
  import { buildBanquetCampaignUrl } from '../scripts/banquet-attribution.mjs';

  const builder = document.querySelector<HTMLElement>('[data-campaign-link-builder]');

  if (builder) {
    const form = builder.querySelector<HTMLFormElement>('[data-campaign-form]');
    const urlOutput = builder.querySelector<HTMLInputElement>('[data-campaign-url]');
    const canvas = builder.querySelector<HTMLCanvasElement>('[data-campaign-qr]');
    const status = builder.querySelector<HTMLElement>('[data-campaign-status]');
    const download = builder.querySelector<HTMLAnchorElement>('[data-download-qr]');
    let renderSequence = 0;

    const buildUrl = () => {
      const data = new FormData(form || undefined);
      const fields = ['source', 'medium', 'campaign', 'content', 'term'] as const;
      return buildBanquetCampaignUrl(window.location.origin, Object.fromEntries(
        fields.map((field) => [field, String(data.get(field) || '')]),
      ));
    };

    const render = async () => {
      if (!form || !urlOutput || !canvas || !download) return;
      if (!form.checkValidity()) {
        if (status) status.textContent = 'Use lowercase letters, numbers, underscores, or hyphens for campaign labels.';
        return;
      }
      const url = buildUrl();
      urlOutput.value = url.href;
      const sequence = ++renderSequence;
      try {
        await QRCode.toCanvas(canvas, url.href, {
          errorCorrectionLevel: 'M',
          margin: 2,
          width: 220,
          color: { dark: '#082b4c', light: '#ffffff' },
        });
        if (sequence !== renderSequence) return;
        download.href = canvas.toDataURL('image/png');
        if (status) status.textContent = 'Link and QR code are ready. Test the QR code before printing.';
      } catch {
        if (status) status.textContent = 'The link is ready, but the QR code could not be generated.';
      }
    };

    form?.addEventListener('input', () => { void render(); });
    form?.addEventListener('change', () => { void render(); });
    builder.querySelector<HTMLButtonElement>('[data-copy-campaign]')?.addEventListener('click', async () => {
      if (!urlOutput?.value) return;
      try {
        await navigator.clipboard.writeText(urlOutput.value);
        if (status) status.textContent = 'Tagged link copied.';
      } catch {
        urlOutput.focus();
        urlOutput.select();
        if (status) status.textContent = 'Copy was blocked by the browser. The full link is selected for manual copying.';
      }
    });
    void render();
  }
</script>

<style>
  .campaign-builder { padding: clamp(1rem, 3vw, 1.6rem); border: 1px solid #d7d2c7; background: white; box-shadow: 0 12px 28px rgb(8 43 76 / 7%); }
  .campaign-copy { max-width: 760px; }
  .campaign-copy h2 { margin: .15rem 0 .45rem; }
  .campaign-copy p:last-child, .builder-note { color: var(--muted); }
  .builder-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, .9fr); gap: clamp(1rem, 4vw, 2.5rem); margin-top: 1.2rem; }
  .builder-form { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-content: start; }
  .builder-form > div { display: grid; gap: .25rem; }
  .builder-form .full { grid-column: 1 / -1; }
  .builder-form label, .link-output label { color: var(--navy); font-weight: 800; }
  .builder-form label span { color: var(--muted); font-weight: 500; }
  .builder-form small { color: var(--muted); }
  .builder-form input, .builder-form select, .link-output input { min-height: 2.8rem; width: 100%; padding: .55rem .65rem; border: 1px solid #9fb0be; border-radius: 6px; background: white; color: var(--ink); font: inherit; }
  .campaign-output { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 1.1rem; align-items: center; min-width: 0; padding: 1rem; background: #f6f4ee; }
  .campaign-output canvas { width: 220px; height: 220px; max-width: 100%; background: white; }
  .link-output { display: grid; gap: .55rem; min-width: 0; }
  .link-output input { font-size: .82rem; }
  .output-actions { display: flex; gap: .6rem; flex-wrap: wrap; }
  .link-output p { margin: 0; color: var(--muted); font-size: .85rem; }
  .builder-note { margin: 1rem 0 0; padding-top: .9rem; border-top: 1px solid #e1ddd4; font-size: .87rem; }
  @media (max-width: 900px) {
    .builder-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .builder-form, .campaign-output { grid-template-columns: 1fr; }
    .builder-form .full { grid-column: auto; }
    .campaign-output canvas { margin-inline: auto; }
  }
</style>
