---
const attendeeSlots = Array.from({ length: 8 }, (_, index) => index + 1);
---

<section
  class="registration-preview"
  aria-labelledby="banquet-registration-heading"
  data-banquet-registration-preview
  data-event-id="banquet-2027"
>
  <div class="preview-heading">
    <p class="kicker">Board review · Stripe test mode</p>
    <h2 id="banquet-registration-heading">Reserve banquet seats</h2>
    <p data-preview-intro>Review the complete guest-registration experience below. Every payment on this preview uses Stripe test mode; no real charge or official reservation can be created.</p>
  </div>

  <div class="checkout-confirmation" data-checkout-success role="status" tabindex="-1" hidden>
    <p class="confirmation-tag">Preview · Stripe test mode</p>
    <h2 class="confirmation-title" data-confirmation-title>Confirming the test payment</h2>
    <p data-confirmation-message>The browser returned from Stripe test Checkout. Waiting for the signed Stripe webhook and checking the server-confirmed D1 payment state…</p>
    <p data-confirmation-detail>No registration-completion event is sent from the return URL alone.</p>
    <p data-confirmation-reference hidden></p>
    <p>Need to correct attendee names, meal choices, or seating notes? Please <a href="/contact/">contact the Hall of Fame team</a>.</p>
    <p class="confirmation-fineprint">This is a test-only preview, not an official receipt, and it does not confirm final seating or table placement.</p>
  </div>

  <div class="form-region" data-form-region>
    <div class="status-notice checkout-canceled" data-checkout-canceled role="alert" hidden>
      <strong>Checkout canceled</strong>
      Checkout was canceled. No registration was completed and no payment was recorded. You can review the form below and try again.
    </div>

  <div class="status-notice status-review" role="status" data-config-status>
    <strong>Loading test event settings</strong>
    Confirming the server-controlled price, menu, capacity, and registration status…
  </div>

  <form class="registration-form" data-registration-form novalidate aria-busy="true">
    <fieldset>
      <legend>Purchaser and contact</legend>
      <div class="form-grid">
        <div class="form-field">
          <label for="banquet-contact-name">Full name</label>
          <input id="banquet-contact-name" name="contact_name" type="text" autocomplete="name" minlength="2" maxlength="100" required />
        </div>
        <div class="form-field">
          <label for="banquet-contact-email">Email</label>
          <input id="banquet-contact-email" name="contact_email" type="email" autocomplete="email" maxlength="254" required />
        </div>
        <div class="form-field">
          <label for="banquet-contact-phone">Phone</label>
          <input id="banquet-contact-phone" name="contact_phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" aria-describedby="banquet-phone-help" required />
          <small id="banquet-phone-help">Enter a phone number with 7–15 digits.</small>
        </div>
        <div class="form-field">
          <label for="banquet-attendee-count">Number of attendees</label>
          <select id="banquet-attendee-count" name="attendee_count" required>
            {attendeeSlots.map((slot) => <option value={slot}>{slot}</option>)}
          </select>
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Attendees and meals</legend>
      <p class="field-help">Provide a full name and choose Chicken or Steak for every attendee. Preparation details and sides are pending final board and caterer approval.</p>
      <div class="attendee-list" data-attendee-list>
        {attendeeSlots.map((slot) => (
          <fieldset class="attendee-card" data-attendee-slot={slot} hidden={slot > 1}>
            <legend>Attendee {slot}</legend>
            <div class="form-grid">
              <div class="form-field">
                <label for={`banquet-attendee-${slot}-name`}>Full name</label>
                <input
                  id={`banquet-attendee-${slot}-name`}
                  name={`attendees[${slot - 1}][full_name]`}
                  type="text"
                  autocomplete="off"
                  minlength="2"
                  maxlength="100"
                  required
                  disabled={slot > 1}
                />
              </div>
              <div class="form-field">
                <label for={`banquet-attendee-${slot}-meal`}>Meal choice</label>
                <select
                  id={`banquet-attendee-${slot}-meal`}
                  name={`attendees[${slot - 1}][meal_id]`}
                  required
                  disabled={slot > 1}
                >
                  <option value="">Loading preview menu…</option>
                </select>
                <small data-meal-help>Meal details come from the same server configuration used at checkout.</small>
              </div>
              <div class="form-field full">
                <label for={`banquet-attendee-${slot}-dietary`}>Dietary restrictions or accommodations <span>(optional)</span></label>
                <textarea
                  id={`banquet-attendee-${slot}-dietary`}
                  name={`attendees[${slot - 1}][dietary_notes]`}
                  rows="2"
                  maxlength="300"
                  aria-describedby={`banquet-attendee-${slot}-dietary-help`}
                  disabled={slot > 1}
                ></textarea>
                <small id={`banquet-attendee-${slot}-dietary-help`}>Provide only relevant allergy or dietary-accommodation information. Do not include unrelated medical information. Up to 300 characters.</small>
              </div>
            </div>
          </fieldset>
        ))}
      </div>
    </fieldset>

    <fieldset>
      <legend>Seating and donation</legend>
      <p class="field-help"><strong>Open seating:</strong> Seating is open except for reserved seating for inductees and their invited guests. We will make reasonable efforts to accommodate group seating requests, but specific tables cannot be guaranteed.</p>
      <div class="form-grid">
        <div class="form-field full">
          <label for="banquet-seating-notes">Seating or table notes <span>(optional)</span></label>
          <textarea id="banquet-seating-notes" name="seating_notes" rows="3" maxlength="300" aria-describedby="banquet-notes-help"></textarea>
          <small id="banquet-notes-help">Up to 300 characters. Specific tables cannot be guaranteed.</small>
        </div>
        <div class="form-field">
          <label for="banquet-donation-amount">Additional donation <span>(optional)</span></label>
          <div class="money-input">
            <span aria-hidden="true">$</span>
          <input id="banquet-donation-amount" name="donation_amount" type="number" inputmode="decimal" min="0" max="0" step="0.01" value="0.00" />
          </div>
        </div>
      </div>
    </fieldset>

    <fieldset class="acknowledgements">
      <legend>Required acknowledgements</legend>
      <p class="field-help">Each box must be selected by the reviewer. None is selected in advance.</p>
      <label><input type="checkbox" name="ack_terms" required /><span class="acknowledgement-copy">I agree to the <a href="/terms/" target="_blank" rel="noopener noreferrer">Terms</a>.</span></label>
      <label><input type="checkbox" name="ack_privacy" required /><span class="acknowledgement-copy">I have read the <a href="/privacy-policy/" target="_blank" rel="noopener noreferrer">Privacy Policy</a>, including the handling of attendee and dietary information.</span></label>
      <label><input type="checkbox" name="ack_accuracy" required /><span class="acknowledgement-copy">I confirm that the purchaser and attendee information is accurate.</span></label>
      <label><input type="checkbox" name="ack_refund" required /><span class="acknowledgement-copy">I understand the refund policy is not yet approved and this test preview cannot create a live purchase.</span></label>
    </fieldset>

    <section class="order-summary" aria-labelledby="banquet-summary-heading">
      <h3 id="banquet-summary-heading">Preview total</h3>
      <dl>
        <div>
          <dt><span data-summary-count>1</span> banquet <span data-seat-label>seat</span> × <span data-ticket-price>Loading…</span></dt>
          <dd data-ticket-subtotal>Loading…</dd>
        </div>
        <div>
          <dt>Additional donation</dt>
          <dd data-donation-total>$0.00</dd>
        </div>
        <div class="summary-total">
          <dt>Total</dt>
          <dd data-grand-total>Loading…</dd>
        </div>
      </dl>
      <p>The Worker recalculates every amount from the server configuration before creating Stripe test Checkout.</p>
    </section>

    <button class="button" type="submit" disabled>Loading test checkout…</button>
    <p class="form-status" data-form-status aria-live="polite" hidden></p>
  </form>
  </div>
</section>

<script>
  import { captureFirstTouchAttribution } from '../scripts/banquet-attribution.mjs';
  import { resolveCheckoutView } from '../scripts/banquet-checkout-view.mjs';

  const preview = document.querySelector<HTMLElement>('[data-banquet-registration-preview]');

  if (preview) {
    const form = preview.querySelector<HTMLFormElement>('[data-registration-form]');
    const attendeeCount = preview.querySelector<HTMLSelectElement>('#banquet-attendee-count');
    const donationInput = preview.querySelector<HTMLInputElement>('#banquet-donation-amount');
    const attendeeSlots = [...preview.querySelectorAll<HTMLFieldSetElement>('[data-attendee-slot]')];
    const status = preview.querySelector<HTMLElement>('[data-form-status]');
    const configStatus = preview.querySelector<HTMLElement>('[data-config-status]');
    const submitButton = preview.querySelector<HTMLButtonElement>('button[type="submit"]');
    const eventId = preview.dataset.eventId || '';
    const formatter = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
    let ticketPriceCents = 0;
    let donationMinCents = 0;
    let donationMaxCents = 0;
    let maxAttendees = 1;
    let checkoutAvailable = false;
    let formStartTracked = false;
    const trackingContext = {
      event_id: eventId,
      event_slug: '2027-hall-of-fame-induction-banquet',
      event_year: 2027,
      test_mode: true,
    };

    const isRecord = (value: unknown): value is Record<string, unknown> => (
      typeof value === 'object' && value !== null && !Array.isArray(value)
    );
    const attribution = captureFirstTouchAttribution(window.location.search, sessionStorage);

    const setStatus = (state: 'error' | 'success' | 'loading', message: string) => {
      if (!status) return;
      status.dataset.state = state;
      status.textContent = message;
      status.hidden = false;
    };

    const trackFormStart = () => {
      if (formStartTracked) return;
      formStartTracked = true;
      window.jrhofTrack?.('registration_form_start', trackingContext);
    };

    const parseDonationCents = () => {
      const value = donationInput?.value.trim() || '0';
      if (!/^\d+(?:\.\d{0,2})?$/.test(value)) return null;
      const cents = Math.round(Number(value) * 100);
      return Number.isSafeInteger(cents) && cents >= donationMinCents && cents <= donationMaxCents ? cents : null;
    };

    const updateAttendees = () => {
      const count = Number(attendeeCount?.value || 1);
      attendeeSlots.forEach((slot, index) => {
        const active = index < count;
        slot.hidden = !active;
        slot.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea').forEach((field) => {
          field.disabled = !active;
        });
      });

      const countNode = preview.querySelector<HTMLElement>('[data-summary-count]');
      const labelNode = preview.querySelector<HTMLElement>('[data-seat-label]');
      if (countNode) countNode.textContent = String(count);
      if (labelNode) labelNode.textContent = count === 1 ? 'seat' : 'seats';
      updateTotals();
    };

    const updateTotals = () => {
      const count = Number(attendeeCount?.value || 1);
      const donationCents = parseDonationCents();
      const ticketSubtotal = ticketPriceCents * count;
      const subtotalNode = preview.querySelector<HTMLElement>('[data-ticket-subtotal]');
      const donationNode = preview.querySelector<HTMLElement>('[data-donation-total]');
      const totalNode = preview.querySelector<HTMLElement>('[data-grand-total]');

      if (subtotalNode) subtotalNode.textContent = checkoutAvailable ? formatter.format(ticketSubtotal / 100) : 'Unavailable';
      if (donationNode) donationNode.textContent = donationCents === null ? 'Invalid' : formatter.format(donationCents / 100);
      if (totalNode) totalNode.textContent = checkoutAvailable && donationCents !== null
        ? formatter.format((ticketSubtotal + donationCents) / 100)
        : 'Unavailable';
    };

    const setTrimmedTextValidity = (input: HTMLInputElement, label: string) => {
      input.setCustomValidity(input.value.trim().length >= 2 ? '' : `${label} must contain at least two characters.`);
    };

    const loadServerConfiguration = async () => {
      try {
        const response = await fetch('/api/banquet/config', {
          method: 'GET',
          credentials: 'same-origin',
          headers: { Accept: 'application/json' },
          referrerPolicy: 'no-referrer',
        });
        const body: unknown = await response.json();
        if (
          !response.ok
          || !isRecord(body)
          || body.testMode !== true
          || body.approvalState !== 'preview_unapproved'
          || !isRecord(body.event)
        ) throw new Error('invalid_preview_configuration');

        const configuredEvent = body.event;
        const integerFields = [
          configuredEvent.capacity,
          configuredEvent.remainingCapacity,
          configuredEvent.maxAttendeesPerRegistration,
          configuredEvent.ticketUnitAmountCents,
          configuredEvent.donationMinCents,
          configuredEvent.donationMaxCents,
        ];
        const validStatuses = new Set(['open', 'scheduled', 'closed', 'sold_out']);
        if (
          configuredEvent.id !== eventId
          || configuredEvent.currency !== 'usd'
          || typeof configuredEvent.registrationStatus !== 'string'
          || !validStatuses.has(configuredEvent.registrationStatus)
          || integerFields.some((value) => !Number.isSafeInteger(value) || Number(value) < 0)
          || Number(configuredEvent.maxAttendeesPerRegistration) < 1
          || Number(configuredEvent.maxAttendeesPerRegistration) > 8
          || Number(configuredEvent.remainingCapacity) > Number(configuredEvent.capacity)
          || Number(configuredEvent.ticketUnitAmountCents) > 1_000_000
          || Number(configuredEvent.donationMaxCents) > 1_000_000
          || Number(configuredEvent.donationMinCents) > Number(configuredEvent.donationMaxCents)
          || !Array.isArray(configuredEvent.meals)
          || configuredEvent.meals.length < 1
          || configuredEvent.meals.length > 12
        ) throw new Error('invalid_preview_configuration');

        const meals = configuredEvent.meals.map((meal) => {
          if (
            !isRecord(meal)
            || typeof meal.id !== 'string'
            || typeof meal.name !== 'string'
            || (meal.description !== null && typeof meal.description !== 'string')
            || meal.available !== true
          ) throw new Error('invalid_preview_configuration');
          return { id: meal.id, name: meal.name, description: meal.description as string | null };
        });

        ticketPriceCents = Number(configuredEvent.ticketUnitAmountCents);
        donationMinCents = Number(configuredEvent.donationMinCents);
        donationMaxCents = Number(configuredEvent.donationMaxCents);
        const remainingCapacity = Number(configuredEvent.remainingCapacity);
        maxAttendees = Math.min(Number(configuredEvent.maxAttendeesPerRegistration), Math.max(1, remainingCapacity));
        checkoutAvailable = configuredEvent.registrationStatus === 'open'
          && remainingCapacity > 0
          && ticketPriceCents > 0;

        if (attendeeCount) {
          for (const option of attendeeCount.options) {
            const optionCount = Number(option.value);
            option.hidden = optionCount > maxAttendees;
            option.disabled = optionCount > maxAttendees;
          }
          if (Number(attendeeCount.value) > maxAttendees) attendeeCount.value = '1';
        }

        for (const select of preview.querySelectorAll<HTMLSelectElement>('select[name$="[meal_id]"]')) {
          const prompt = new Option('Select a meal', '');
          select.replaceChildren(prompt, ...meals.map((meal) => new Option(
            meal.description ? `${meal.name} — ${meal.description}` : meal.name,
            meal.id,
          )));
        }
        for (const help of preview.querySelectorAll<HTMLElement>('[data-meal-help]')) {
          help.textContent = meals.every((meal) => meal.description)
            ? 'Choose one meal for each attendee.'
            : 'Chicken and Steak are confirmed; preparation details and sides are pending final approval.';
        }

        if (donationInput) {
          donationInput.min = (donationMinCents / 100).toFixed(2);
          donationInput.max = (donationMaxCents / 100).toFixed(2);
          if (parseDonationCents() === null) donationInput.value = (donationMinCents / 100).toFixed(2);
        }
        const priceNode = preview.querySelector<HTMLElement>('[data-ticket-price]');
        if (priceNode) priceNode.textContent = formatter.format(ticketPriceCents / 100);

        if (configStatus) {
          const strong = document.createElement('strong');
          strong.textContent = checkoutAvailable ? 'Test configuration loaded' : 'Test checkout is closed';
          const decisionNote = configuredEvent.refundPolicyApproved === true
            ? 'The configured refund policy is present.'
            : 'Price, meal preparation details, capacity, dates, and refund language still require board approval.';
          const stateNote = configuredEvent.registrationStatus === 'sold_out'
            ? 'No preview seats remain.'
            : configuredEvent.registrationStatus === 'scheduled'
              ? 'The configured preview window has not opened.'
              : configuredEvent.registrationStatus === 'closed'
                ? 'The configured preview window is closed.'
                : `${remainingCapacity} of ${configuredEvent.capacity} test seats remain.`;
          configStatus.replaceChildren(strong, document.createTextNode(` Illustrative ticket price: ${formatter.format(ticketPriceCents / 100)}. ${stateNote} ${decisionNote}`));
        }

        form?.setAttribute('aria-busy', 'false');
        if (submitButton) {
          submitButton.disabled = !checkoutAvailable;
          submitButton.textContent = checkoutAvailable
            ? 'Continue to Stripe test checkout'
            : 'Test checkout unavailable';
        }
        updateAttendees();
      } catch {
        checkoutAvailable = false;
        form?.setAttribute('aria-busy', 'false');
        if (configStatus) {
          const strong = document.createElement('strong');
          strong.textContent = 'Test checkout unavailable';
          configStatus.replaceChildren(strong, document.createTextNode(' The server configuration could not be verified. No information can be submitted and no payment can start.'));
        }
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'Test checkout unavailable';
        }
        updateTotals();
      }
    };

    attendeeCount?.addEventListener('change', updateAttendees);
    donationInput?.addEventListener('input', () => {
      donationInput.setCustomValidity(parseDonationCents() === null
        ? `Enter an amount from ${formatter.format(donationMinCents / 100)} to ${formatter.format(donationMaxCents / 100)} with no more than two decimal places.`
        : '');
      updateTotals();
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form || !attendeeCount || !donationInput) return;

      const contactName = form.elements.namedItem('contact_name');
      const contactPhone = form.elements.namedItem('contact_phone');
      if (contactName instanceof HTMLInputElement) setTrimmedTextValidity(contactName, 'Contact name');
      if (contactPhone instanceof HTMLInputElement) {
        const digitCount = contactPhone.value.replace(/\D/g, '').length;
        contactPhone.setCustomValidity(digitCount >= 7 && digitCount <= 15 ? '' : 'Enter a phone number with 7–15 digits.');
      }

      form.querySelectorAll<HTMLInputElement>('[name^="attendees"][name$="[full_name]"]:not(:disabled)').forEach((input) => {
        setTrimmedTextValidity(input, 'Attendee name');
      });
      donationInput.setCustomValidity(parseDonationCents() === null
        ? `Enter an amount from ${formatter.format(donationMinCents / 100)} to ${formatter.format(donationMaxCents / 100)} with no more than two decimal places.`
        : '');

      if (!form.checkValidity()) {
        setStatus('error', 'Please correct the highlighted fields before continuing. No information has been sent.');
        form.reportValidity();
        return;
      }

      if (!checkoutAvailable) {
        setStatus('error', 'The server-controlled test checkout is not available. No information has been sent.');
        return;
      }

      const activeAttendees = [...form.querySelectorAll<HTMLFieldSetElement>('[data-attendee-slot]:not([hidden])')].map((slot) => {
        const fullName = slot.querySelector<HTMLInputElement>('input[name$="[full_name]"]');
        const meal = slot.querySelector<HTMLSelectElement>('select[name$="[meal_id]"]');
        const dietaryNotes = slot.querySelector<HTMLTextAreaElement>('textarea[name$="[dietary_notes]"]');
        return {
          fullName: fullName?.value.trim() || '',
          mealId: meal?.value || '',
          dietaryNotes: dietaryNotes?.value.trim() || null,
        };
      });
      const email = form.elements.namedItem('contact_email');
      const seatingNotes = form.elements.namedItem('seating_notes');
      const donationAmountCents = parseDonationCents();
      if (
        !(contactName instanceof HTMLInputElement)
        || !(email instanceof HTMLInputElement)
        || !(contactPhone instanceof HTMLInputElement)
        || !(seatingNotes instanceof HTMLTextAreaElement)
        || donationAmountCents === null
      ) {
        setStatus('error', 'The preview form could not be prepared. No information has been sent.');
        return;
      }

      submitButton?.setAttribute('disabled', '');
      setStatus('loading', 'Starting Stripe test checkout…');
      try {
        const response = await fetch('/api/banquet/checkout', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            eventId,
            contact: {
              name: contactName.value.trim(),
              email: email.value.trim(),
              phone: contactPhone.value.trim(),
            },
            attendees: activeAttendees,
            seatingNotes: seatingNotes.value.trim() || null,
            donationAmountCents,
            attribution,
            acknowledgements: {
              terms: (form.elements.namedItem('ack_terms') as HTMLInputElement | null)?.checked === true,
              privacy: (form.elements.namedItem('ack_privacy') as HTMLInputElement | null)?.checked === true,
              informationAccuracy: (form.elements.namedItem('ack_accuracy') as HTMLInputElement | null)?.checked === true,
              refundPolicy: (form.elements.namedItem('ack_refund') as HTMLInputElement | null)?.checked === true,
            },
          }),
        });
        const body: unknown = await response.json();
        if (
          !response.ok
          || typeof body !== 'object'
          || body === null
          || !('checkoutUrl' in body)
          || typeof body.checkoutUrl !== 'string'
          || !('reservationId' in body)
          || typeof body.reservationId !== 'string'
          || !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/iu.test(body.reservationId)
        ) {
          throw new Error('checkout_request_rejected');
        }
        const checkoutUrl = new URL(body.checkoutUrl);
        if (checkoutUrl.protocol !== 'https:' || checkoutUrl.hostname !== 'checkout.stripe.com') {
          throw new Error('invalid_checkout_url');
        }
        try {
          sessionStorage.setItem('jrhof:banquet-checkout-reference', body.reservationId);
        } catch {
          throw new Error('confirmation_reference_unavailable');
        }
        window.jrhofTrack?.('begin_checkout', {
          ...trackingContext,
          attendee_count: activeAttendees.length,
          value: ((ticketPriceCents * activeAttendees.length) + donationAmountCents) / 100,
          currency: 'USD',
        });
        setStatus('success', 'Server validation passed. Redirecting to Stripe test Checkout…');
        await new Promise((resolve) => window.setTimeout(resolve, 100));
        window.location.assign(checkoutUrl.href);
      } catch {
        setStatus('error', 'Test checkout is unavailable. Confirm the local preview Worker, D1 migrations, and Stripe test secrets are configured. No payment was started.');
        if (checkoutAvailable) submitButton?.removeAttribute('disabled');
      }
    });

    form?.addEventListener('input', (event) => {
      if (event.target instanceof HTMLInputElement || event.target instanceof HTMLSelectElement || event.target instanceof HTMLTextAreaElement) {
        trackFormStart();
        event.target.setCustomValidity('');
      }
    });
    form?.addEventListener('change', trackFormStart);

    const wait = (milliseconds: number) => new Promise((resolve) => window.setTimeout(resolve, milliseconds));

    const confirmReturnedCheckout = async () => {
      const confirmation = preview.querySelector<HTMLElement>('[data-checkout-success]');
      const title = preview.querySelector<HTMLElement>('[data-confirmation-title]');
      const message = preview.querySelector<HTMLElement>('[data-confirmation-message]');
      const detail = preview.querySelector<HTMLElement>('[data-confirmation-detail]');
      const referenceNode = preview.querySelector<HTMLElement>('[data-confirmation-reference]');
      let reference = '';
      try {
        reference = sessionStorage.getItem('jrhof:banquet-checkout-reference') || '';
      } catch {
        reference = '';
      }

      if (!/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/iu.test(reference)) {
        if (title) title.textContent = 'Test payment not yet verified';
        if (message) message.textContent = 'This browser does not have the opaque registration reference created before Stripe Checkout, so it cannot check the server-confirmed payment state.';
        if (detail) detail.textContent = 'No registration-completion event was sent. Use the protected preview export or D1 record for operator verification.';
        return;
      }

      for (let attempt = 0; attempt < 10; attempt += 1) {
        try {
          const response = await fetch(`/api/banquet/confirmation?reference=${encodeURIComponent(reference)}`, {
            method: 'GET',
            credentials: 'same-origin',
            headers: { Accept: 'application/json' },
            referrerPolicy: 'no-referrer',
          });
          const body: unknown = await response.json();
          if (response.ok && typeof body === 'object' && body !== null && 'status' in body) {
            if (
              body.status === 'confirmed'
              && 'transactionId' in body
              && typeof body.transactionId === 'string'
              && body.transactionId === reference
              && 'totalCents' in body
              && typeof body.totalCents === 'number'
              && Number.isSafeInteger(body.totalCents)
              && Number(body.totalCents) >= 0
              && 'currency' in body
              && body.currency === 'usd'
            ) {
              if (title) title.textContent = 'Test payment confirmed';
              if (message) message.textContent = 'A signature-verified Stripe webhook marked this preview registration paid in D1. This is the first point at which the browser may report a completed registration.';
              if (detail) detail.textContent = 'The test-only completion signal contains no purchaser, attendee, meal, dietary, seating, or Stripe identifiers.';
              if (referenceNode) {
                referenceNode.textContent = `Preview confirmation reference: ${reference}`;
                referenceNode.hidden = false;
              }
              try {
                const dedupeKey = `jrhof:registration_complete:${reference}`;
                if (sessionStorage.getItem(dedupeKey) !== 'sent') {
                  sessionStorage.setItem(dedupeKey, 'sent');
                  window.jrhofTrack?.('registration_complete', {
                    transaction_id: reference,
                    value: Number(body.totalCents) / 100,
                    currency: 'USD',
                    ...trackingContext,
                    payment_status: 'paid',
                  });
                }
                sessionStorage.removeItem('jrhof:banquet-checkout-reference');
              } catch {
                // Confirmation remains visible, but tracking fails closed without deduplication storage.
              }
              confirmation?.setAttribute('data-confirmation-state', 'confirmed');
              return;
            }
            if (body.status === 'not_completed') {
              if (title) title.textContent = 'Test payment was not completed';
              if (message) message.textContent = 'The server record is not paid. No registration-completion event was sent.';
              if (detail) detail.textContent = 'Review the protected preview export or D1 record before retrying.';
              try { sessionStorage.removeItem('jrhof:banquet-checkout-reference'); } catch { /* no-op */ }
              return;
            }
          }
        } catch {
          // Retry boundedly to allow the verified webhook to arrive after the browser return.
        }
        if (attempt < 9) await wait(1_000);
      }

      if (title) title.textContent = 'Test payment is still processing';
      if (message) message.textContent = 'The server has not confirmed a paid record yet. No registration-completion event was sent.';
      if (detail) detail.textContent = 'Do not treat the return URL as proof of payment; verify through the protected preview export or D1 record.';
    };

    const applyCheckoutView = () => {
      const view = resolveCheckoutView(window.location.search);
      const formRegion = preview.querySelector<HTMLElement>('[data-form-region]');
      const confirmation = preview.querySelector<HTMLElement>('[data-checkout-success]');
      const canceledNotice = preview.querySelector<HTMLElement>('[data-checkout-canceled]');
      const previewIntro = preview.querySelector<HTMLElement>('[data-preview-intro]');

      if (view === 'success') {
        if (formRegion) formRegion.hidden = true;
        if (previewIntro) previewIntro.hidden = true;
        if (confirmation) {
          confirmation.hidden = false;
          confirmation.focus();
        }
        void confirmReturnedCheckout();
        return;
      }

      if (view === 'canceled' && canceledNotice) {
        try {
          const reference = sessionStorage.getItem('jrhof:banquet-checkout-reference') || '';
          if (/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/iu.test(reference)) {
            const dedupeKey = `jrhof:checkout_canceled:${reference}`;
            if (sessionStorage.getItem(dedupeKey) !== 'sent') {
              sessionStorage.setItem(dedupeKey, 'sent');
              window.jrhofTrack?.('checkout_canceled', trackingContext);
            }
          }
          sessionStorage.removeItem('jrhof:banquet-checkout-reference');
        } catch { /* no-op */ }
        canceledNotice.hidden = false;
        canceledNotice.scrollIntoView({ block: 'nearest' });
      }
    };

    applyCheckoutView();
    updateAttendees();
    void loadServerConfiguration();
  }
</script>

