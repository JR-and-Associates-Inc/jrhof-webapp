---
// Embeds a Zeffy form with Zeffy's v2 embed script. The script only accepts
// resize messages from https://www.zeffy.com. If it fails to load, the plain
// iframe fallback is shown instead. Registration forms also show a direct link
// to Zeffy's own page; donation forms don't (Ad Grants visitors stay on
// jrhof.org). Several embeds can share a page; each counts its own conversion.
// A lazy embed (the newsletter) loads nothing from Zeffy until it scrolls near
// the screen or its button is clicked.
// public/_headers must allow https://www.zeffy.com for the page that uses this.
// data-clarity-mask keeps the form area out of Clarity recordings (ADR-018).
import { zeffyEmbedPath, zeffyEmbedScript, zeffyHostedUrl, zeffyOrigin, type ZeffyForm } from '../config/zeffy';
import type { ZeffyConversion } from '../lib/zeffyTracking';

interface Props {
  form: ZeffyForm;
  minHeight?: number;
  /** Conversion sent to the dataLayer when Zeffy shows its thank-you screen. */
  conversion: ZeffyConversion;
  /** Extra analytics parameters, such as event_slug and event_year. */
  analytics?: Record<string, string>;
  /** Show the "Form not loading?" link to Zeffy's own page (default true). */
  directLink?: boolean;
  /** Load the form only when it nears the screen or the button is clicked. */
  lazy?: boolean;
  /** Button text shown before a lazy form loads. */
  loadLabel?: string;
}

const { form, minHeight = 640, conversion, analytics = {}, directLink = true, lazy = false, loadLabel = 'Show the form' } = Astro.props;
const embedPath = zeffyEmbedPath(form);
---
<div
  class="zeffy-frame"
  data-zeffy-wrapper
  data-clarity-mask="true"
  data-zeffy-script={zeffyEmbedScript}
  data-zeffy-conversion={conversion}
  data-zeffy-analytics={JSON.stringify(analytics)}
  data-zeffy-lazy={lazy ? 'true' : undefined}
  data-zeffy-form-url={embedPath}
  data-zeffy-min-height={String(minHeight)}
  style={`--zeffy-fallback-height: ${Math.max(minHeight, 320)}px`}
>
  {lazy
    ? <button type="button" class="button button-secondary zeffy-load" data-zeffy-load>{loadLabel}</button>
    : <div data-zeffy-embed data-form-url={embedPath} data-min-height={String(minHeight)}></div>}
  <div class="zeffy-fallback" data-zeffy-embed-fallback hidden>
    <iframe
      title={form.title}
      data-zeffy-embed-src={`${zeffyOrigin}${embedPath}`}
      allow="payment"
      loading="lazy"
    ></iframe>
  </div>
  {directLink && <p class="zeffy-direct">Form not loading? <a href={zeffyHostedUrl(form)} target="_blank" rel="noopener noreferrer">Open the registration form on Zeffy</a>.</p>}
</div>

<script>
  import { createZeffyTracker, isZeffyMessage } from '../lib/zeffyTracking';
  import type { ZeffyConversion } from '../lib/zeffyTracking';

  // Load Zeffy's script once. If it is already running, ask it to pick up new
  // embeds. On failure, show the fallback iframe of every active embed (the
  // same behavior as Zeffy's published snippet).
  const wrappers = [...document.querySelectorAll<HTMLElement>('[data-zeffy-wrapper]')];
  let scriptFailed = false;
  const showFallback = (wrapper: HTMLElement) => {
    wrapper.querySelectorAll<HTMLElement>('[data-zeffy-embed], [data-zeffy-load]').forEach((el) => { el.hidden = true; });
    wrapper.querySelectorAll<HTMLElement>('[data-zeffy-embed-fallback]').forEach((el) => {
      el.hidden = false;
      el.querySelectorAll<HTMLIFrameElement>('iframe[data-zeffy-embed-src]').forEach((frame) => {
        frame.src = frame.dataset.zeffyEmbedSrc!;
      });
    });
  };
  const loadZeffy = (src: string) => {
    const zeffy = (window as unknown as { Zeffy?: { embed?: { init?: () => void } } }).Zeffy;
    if (zeffy?.embed?.init) {
      zeffy.embed.init();
      return;
    }
    if (document.querySelector('script[data-zeffy-loader]')) return; // Still loading; it scans every embed when ready.
    const script = document.createElement('script');
    script.src = src;
    script.async = true;
    script.dataset.zeffyLoader = 'true';
    script.addEventListener('error', () => {
      scriptFailed = true;
      wrappers.filter((wrapper) => wrapper.dataset.zeffyActive).forEach(showFallback);
    });
    document.head.append(script);
  };
  const activate = (wrapper: HTMLElement) => {
    if (wrapper.dataset.zeffyActive) return;
    wrapper.dataset.zeffyActive = 'true';
    if (wrapper.dataset.zeffyLazy) {
      const embed = document.createElement('div');
      embed.dataset.zeffyEmbed = '';
      embed.dataset.formUrl = wrapper.dataset.zeffyFormUrl!;
      embed.dataset.minHeight = wrapper.dataset.zeffyMinHeight!;
      wrapper.querySelector('[data-zeffy-load]')?.replaceWith(embed);
    }
    if (scriptFailed) showFallback(wrapper);
    else loadZeffy(wrapper.dataset.zeffyScript!);
  };

  const lazyWrappers = wrappers.filter((wrapper) => wrapper.dataset.zeffyLazy);
  wrappers.filter((wrapper) => !wrapper.dataset.zeffyLazy).forEach(activate);
  lazyWrappers.forEach((wrapper) => {
    wrapper.querySelector('[data-zeffy-load]')?.addEventListener('click', () => activate(wrapper));
  });
  if (lazyWrappers.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        activate(entry.target as HTMLElement);
      }
    }, { rootMargin: '200px 0px' });
    lazyWrappers.forEach((wrapper) => observer.observe(wrapper));
  }

  // Conversion tracking: each Zeffy iframe posts zeffy-embed:* messages to
  // this page. A message counts only when it comes from https://www.zeffy.com
  // and from a frame inside one of these wrappers, and it goes to that
  // wrapper's own tracker. See src/lib/zeffyTracking.ts.
  const track = (eventName: string, params: Record<string, string>) => {
    const w = window as unknown as {
      jrhofTrack?: (name: string, params: Record<string, string>) => void;
      dataLayer?: unknown[];
    };
    if (w.jrhofTrack) w.jrhofTrack(eventName, params);
    else (w.dataLayer ||= []).push({ event: eventName, ...params });
  };
  const trackers = wrappers.map((wrapper) => {
    let analytics: Record<string, string> = {};
    try {
      analytics = JSON.parse(wrapper.dataset.zeffyAnalytics || '{}');
    } catch {
      analytics = {};
    }
    const handle = createZeffyTracker({
      track,
      conversion: wrapper.dataset.zeffyConversion as ZeffyConversion,
      params: analytics,
      hostname: window.location.hostname,
      newId: () => crypto.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}`,
    });
    return { wrapper, handle };
  });
  if (trackers.length) {
    window.addEventListener('message', (event) => {
      const target = trackers.find(({ wrapper }) => isZeffyMessage(event, wrapper.querySelectorAll<HTMLIFrameElement>('iframe')));
      target?.handle(event.data);
    });
  }
</script>

<style>
  .zeffy-frame { display: grid; gap: .75rem; }
  /* Zeffy sets inline container styles; align them with JRHOF surfaces. */
  .zeffy-frame [data-zeffy-embed] {
    max-width: 100% !important;
    outline-color: var(--surface-border) !important;
    border-radius: 12px !important;
    box-shadow: var(--surface-shadow);
  }
  .zeffy-load { justify-self: start; }
  .zeffy-fallback { position: relative; overflow: hidden; height: var(--zeffy-fallback-height, 800px); border: 1px solid var(--surface-border); border-radius: 12px; background: white; }
  .zeffy-fallback[hidden] { display: none; }
  .zeffy-fallback iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .zeffy-direct { margin: 0; color: var(--muted); font-size: .95rem; text-align: center; }
</style>
