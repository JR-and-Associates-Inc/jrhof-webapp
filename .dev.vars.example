# Copy to .dev.vars for local Worker testing only. Never commit the copied file.
# Use Stripe test-mode values only; live keys are rejected by the Worker.
#
# These values are runtime secrets. For the REMOTE feature preview do NOT put
# them in a file — upload them as Worker secrets instead:
#   wrangler secret put STRIPE_SECRET_KEY    --config wrangler.banquet-remote-preview.jsonc
#   wrangler secret put STRIPE_WEBHOOK_SECRET --config wrangler.banquet-remote-preview.jsonc
#   wrangler secret put BOARD_REPORT_ALLOWED_EMAILS --config wrangler.banquet-remote-preview.jsonc
#
# BANQUET_REGISTRATION_PREVIEW=true is a build-time route gate (see
# scripts/build-site.mjs), not a secret. Price, menu, capacity, and registration
# state come only from the preview D1 configuration at runtime.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_LOCAL_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_LOCAL_TEST_WEBHOOK_SECRET
BOARD_REPORT_ALLOWED_EMAILS=board-member@example.invalid
