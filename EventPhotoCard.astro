---
// Photo card for one event: cover photograph, year and program, title, date,
// honorees, and a call to action. Used on the homepage, the events hub, the
// program pages, the archive, and the "more events" rows on event pages.
import { trackingAttrs } from '../config/site';
import { galleryCover } from '../data/galleries/covers';
import type { EventRecord } from '../data/events';

interface Props {
  event: EventRecord;
  /** Show the honoree names (on by default). */
  showHonorees?: boolean;
}

const { event, showHonorees = true } = Astro.props;
const cover = galleryCover(event);
const upcoming = event.status === 'scheduled' || event.status === 'registration-open';
const typeLabel = event.eventType === 'golf' ? 'Golf tournament' : 'Induction banquet';
const action = event.gallery?.status === 'published'
  ? `${event.gallery.count} photographs →`
  : upcoming
    ? event.registration?.status === 'open' ? 'Register and event details →' : 'Event details →'
    : 'View the event record →';
---
{/* No gallery_open here: that event is reserved for real lightbox opens (GalleryGrid).
    Navigation to an event page is measured by page_view; banquet links also send
    banquet_info_click, the taxonomy event for banquet-detail intent. */}
<a class:list={['event-photo-card', { 'is-upcoming': upcoming }]} href={event.canonicalPath} {...(event.eventType === 'induction-banquet' ? trackingAttrs('banquet_info_click', { event_name: event.title, destination_url: event.canonicalPath }) : {})}>
  <span class:list={['event-photo', { 'is-placeholder': !cover && !event.heroImage }]}>
    {cover
      ? <img src={cover.thumbnail} alt="" width={cover.thumbnailWidth} height={cover.thumbnailHeight} loading="lazy" decoding="async" />
      : event.heroImage
        ? <img src={event.heroImage} alt="" width="1774" height="887" loading="lazy" decoding="async" />
        : <span class="event-photo-year" aria-hidden="true">{event.year}</span>}
    {upcoming && <span class="event-photo-badge">Upcoming</span>}
  </span>
  <span class="event-photo-body">
    <small>{event.year} · {typeLabel}</small>
    <strong>{event.shortTitle}</strong>
    <span>{event.displayDate}</span>
    {showHonorees && event.inductees.length > 0 && <span class="event-photo-honorees">Honoring {event.inductees.join(', ')}</span>}
    <em>{action}</em>
  </span>
</a>

<style>
  .event-photo-card { display: grid; grid-template-rows: auto 1fr; overflow: hidden; height: 100%; color: var(--ink); text-align: left; border: 1px solid var(--surface-border); border-radius: 12px; background: rgb(255 255 255 / 88%); box-shadow: 0 10px 26px rgb(8 43 76 / 9%); text-decoration: none; }
  .event-photo-card:hover { color: var(--ink); }
  .event-photo { position: relative; display: block; overflow: hidden; aspect-ratio: 3 / 2; background: linear-gradient(160deg, #0a2946, #126293); }
  .event-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .is-upcoming .event-photo img { object-position: 65% center; }
  .event-photo.is-placeholder { display: grid; place-items: center; background: radial-gradient(circle at 30% 20%, rgb(232 182 70 / 22%), transparent 55%), linear-gradient(160deg, #0a2946, #0d4a75); }
  .event-photo-year { color: rgb(243 206 135 / 85%); font: 700 clamp(2.4rem, 5vw, 3.2rem)/1 Georgia, serif; letter-spacing: .04em; }
  .event-photo-badge { position: absolute; top: .7rem; left: .7rem; padding: .25rem .6rem; border-radius: 999px; color: #071d33; background: #e8b646; font-size: .72rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .event-photo-body { display: grid; align-content: start; gap: .3rem; padding: .9rem 1rem 1rem; }
  .event-photo-body small { color: #7c5817; font-size: .74rem; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  .event-photo-body strong { color: var(--navy); font: 700 1.15rem/1.2 Georgia, serif; }
  .event-photo-body > span { color: var(--muted); font-size: .92rem; }
  .event-photo-honorees { line-height: 1.35; }
  .event-photo-body em { margin-top: .35rem; color: var(--navy); font-style: normal; font-weight: 800; }
  .event-photo-card:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
  /* Phones: photo beside the text so a list of cards stays short. */
  @media (max-width: 560px) {
    .event-photo-card { grid-template-columns: 38% minmax(0, 1fr); grid-template-rows: none; }
    .event-photo { aspect-ratio: auto; min-height: 100%; }
    .event-photo-year { font-size: 1.8rem; }
    .event-photo-badge { top: .45rem; left: .45rem; padding: .18rem .45rem; font-size: .62rem; }
    .event-photo-body { gap: .2rem; padding: .7rem .8rem .8rem; }
    .event-photo-body strong { font-size: 1.05rem; }
    .event-photo-body > span { font-size: .85rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .event-photo-card { transition: transform .18s ease, box-shadow .18s ease; }
    .event-photo-card:hover { transform: translateY(-2px); box-shadow: 0 16px 34px rgb(8 43 76 / 16%); }
  }
</style>
